{
    "name": "wezurlop/tenant",
    "description": "wezurlop — aplikacja tenanta",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3 <8.6",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-openssl": "*",
        "ext-iconv": "*",
        "ext-xmlwriter": "*",
        "twig/twig": "^3.8",
        "nikic/fast-route": "^1.3",
        "vlucas/phpdotenv": "^5.6",
        "robthree/twofactorauth": "^3.0",
        "bacon/bacon-qr-code": "^2.0",
        "paragonie/sodium_compat": "^1.21",
        "robmorgan/phinx": "^0.16",
        "phpmailer/phpmailer": "^6.9"
    },
    "autoload": {
        "psr-4": {
            "Wezurlop\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wezurlop\\Dev\\": "dev/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require-dev": {
        "phpcompatibility/php-compatibility": "10.0.0-alpha2"
    }
}
