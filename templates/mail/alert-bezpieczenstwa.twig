{% extends 'layout.twig' %}

{#- Alert bezpieczeństwa — idzie na skrzynkę alertową, nie do pracownika. Bez przycisku, bo nie ma
    czego kliknąć, i bez zieleni, bo zieleń znaczy akcję.

    ⚠ WYŁĄCZNIE LICZBY: zero adresów, zero nazw kont (CLAUDE.md §14). Szczegóły zostają
    w dzienniku zdarzeń. Zmienne: naglowek, zdanie, wiersze (etykieta => wartość), firma. -#}
{% block naglowek %}{{ naglowek }}{% endblock %}

{% block tresc %}
        <tr><td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; font-size:15px; line-height:1.6; color:#2A2F39; padding:0 0 20px 0;">{{ zdanie }}</td></tr>

        {% if wiersze %}
        <tr><td style="padding:0 0 20px 0;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #E6E8EC; border-radius:8px;">
            {% for w in wiersze %}
            <tr><td style="padding:10px 16px;{% if not loop.last %} border-bottom:1px solid #F0F2F5;{% endif %} font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; font-size:13px; color:#6B7280;">{{ w.etykieta }}<span style="float:right; color:#2A2F39;">{{ w.wartosc }}</span></td></tr>
            {% endfor %}
          </table>
        </td></tr>
        {% endif %}

        <tr><td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; font-size:13px; line-height:1.6; color:#6B7280;">
          Szczegóły są w dzienniku zdarzeń, w zakładce Administracja. Ta wiadomość nie zawiera adresów ani nazw kont.
        </td></tr>
{% endblock %}

{% block stopka %}{% endblock %}
