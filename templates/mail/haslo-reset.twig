{% extends 'layout.twig' %}

{#- Reset hasła — ten sam układ, krótsza treść, inny termin ważności.
    Zmienne: login, link, waznosc, firma. -#}
{% block naglowek %}Ustawienie nowego hasła{% endblock %}

{% block tresc %}
        <tr><td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; font-size:15px; line-height:1.6; color:#2A2F39; padding:0 0 22px 0;">
          Ktoś poprosił o ustawienie nowego hasła do konta <strong style="font-weight:600;">{{ login }}</strong>. Jeśli to Ty, kliknij poniżej.
        </td></tr>

        <tr><td style="padding:0 0 18px 0;">
          <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
            <td align="center" bgcolor="#12874A" style="border-radius:8px;">
              <a href="{{ link }}" style="display:inline-block; padding:13px 26px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; font-size:15px; font-weight:600; color:#FFFFFF; text-decoration:none; border-radius:8px;">Ustaw nowe hasło</a>
            </td>
          </tr></table>
        </td></tr>

        <tr><td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; font-size:13px; line-height:1.6; color:#6B7280; padding:0 0 18px 0;">
          Link jest ważny <strong style="color:#2A2F39; font-weight:600;">{{ waznosc }}</strong> i działa jeden raz. Ustawienie nowego hasła kończy wszystkie Twoje sesje na innych urządzeniach.<br>
          Jeśli przycisk nie działa, skopiuj ten adres do przeglądarki:<br>
          <span style="color:#0E6E3C; word-break:break-all;">{{ link }}</span>
        </td></tr>

        {#- Ostrzeżenie w bursztynie: odstępstwo dostaje kolor, stan normalny nie (§3.1). -#}
        <tr><td style="border-left:3px solid #F0D8A8; background:#FDF3E2; border-radius:0 8px 8px 0; padding:12px 16px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; font-size:13px; line-height:1.6; color:#8A5300;">
          Jeśli to nie Ty prosiłeś o zmianę — nie klikaj i powiedz o tym administratorowi. Dopóki nie klikniesz, Twoje hasło się nie zmienia.
        </td></tr>
{% endblock %}

{% block stopka %}{% endblock %}
