{% extends 'layout.twig' %}

{#- Zaproszenie do systemu — najważniejsza wiadomość w produkcie: od niej zależy, czy pracownik
    w ogóle wejdzie. Zmienne: imie_w_wolaczu, firma, link, login, zapraszajacy, waznosc_dni. -#}
{% block naglowek %}Masz dostęp do systemu urlopowego{% endblock %}

{% block tresc %}
        <tr><td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; font-size:15px; line-height:1.6; color:#2A2F39; padding:0 0 10px 0;">Dzień dobry{% if imie_w_wolaczu %}, {{ imie_w_wolaczu }}{% endif %}.</td></tr>

        <tr><td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; font-size:15px; line-height:1.6; color:#2A2F39; padding:0 0 22px 0;">
          {% if firma %}<strong style="font-weight:600;">{{ firma }}</strong> udostępnia Ci system{% else %}Masz dostęp do systemu{% endif %}, w którym składasz wnioski urlopowe, sprawdzasz swój limit dni i widzisz kalendarz nieobecności zespołu. Żeby zacząć, ustaw własne hasło.
        </td></tr>

        {#- Przycisk zbudowany z komórki z tłem: promień na `<a>` Outlook ignoruje, tło komórki nie. -#}
        <tr><td style="padding:0 0 18px 0;">
          <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
            <td align="center" bgcolor="#12874A" style="border-radius:8px;">
              <a href="{{ link }}" style="display:inline-block; padding:13px 26px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; font-size:15px; font-weight:600; color:#FFFFFF; text-decoration:none; border-radius:8px;">Ustaw hasło i zaloguj się</a>
            </td>
          </tr></table>
        </td></tr>

        {#- ⚠ Adres także jako TEKST do skopiowania: gdy przycisk się nie wyrenderuje (tryb
            tekstowy, blokada stylów), zaproszenie bez adresu jest bezużyteczne. -#}
        <tr><td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; font-size:13px; line-height:1.6; color:#6B7280; padding:0 0 22px 0;">
          Link jest ważny <strong style="color:#2A2F39; font-weight:600;">{{ waznosc_dni }}</strong> i działa jeden raz. Jeśli przycisk nie działa, skopiuj ten adres do przeglądarki:<br>
          <span style="color:#0E6E3C; word-break:break-all;">{{ link }}</span>
        </td></tr>

        <tr><td style="border-top:1px solid #F0F2F5; padding:18px 0 0 0;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td width="120" style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; font-size:13px; line-height:1.7; color:#6B7280;">Twój login</td>
              <td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; font-size:13px; line-height:1.7; color:#2A2F39;">{{ login }}</td>
            </tr>
            {% if zapraszajacy %}
            <tr>
              <td width="120" style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; font-size:13px; line-height:1.7; color:#6B7280;">Zaprosił</td>
              <td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; font-size:13px; line-height:1.7; color:#2A2F39;">{{ zapraszajacy }}</td>
            </tr>
            {% endif %}
          </table>
        </td></tr>
{% endblock %}

{% block stopka %}Nie spodziewałeś się tej wiadomości? Zignoruj ją — bez ustawienia hasła konto pozostaje nieaktywne.<br>
{% endblock %}
