{#- Zaproszenie do aplikacji — najważniejsza wiadomość w produkcie: od niej zależy, czy pracownik
    w ogóle wejdzie. Przycisk i adres pod nim rysuje `layout.twig` z `akcja` (zlecenie Z60).
    Zmienne: imie_w_wolaczu, firma, login, zapraszajacy, waznosc_dni. -#}
{% extends 'layout.twig' %}

{% block naglowek %}Masz dostęp do systemu urlopowego{% endblock %}

{% block tresc %}
        <tr><td style="font-family:{{ kroj }}; font-size:15px; line-height:1.6; color:{{ barwy.tekst }}; padding:0 0 10px 0;">Dzień dobry{% if imie_w_wolaczu %}, {{ imie_w_wolaczu }}{% endif %}.</td></tr>

        <tr><td style="font-family:{{ kroj }}; font-size:15px; line-height:1.6; color:{{ barwy.tekst }}; padding:0 0 18px 0;">
          {% if firma %}<strong style="font-weight:600;">{{ firma }}</strong> udostępnia Ci system{% else %}Masz dostęp do systemu{% endif %}, w którym składasz wnioski urlopowe, sprawdzasz swój limit dni i widzisz kalendarz nieobecności zespołu. Żeby zacząć, ustaw własne hasło.
        </td></tr>

        <tr><td style="font-family:{{ kroj }}; font-size:13px; line-height:1.6; color:{{ barwy.podpis }}; padding:0 0 18px 0;">
          Link jest ważny <strong style="color:{{ barwy.tekst }}; font-weight:600;">{{ waznosc_dni }}</strong> i działa jeden raz.
        </td></tr>

        <tr><td style="border-top:1px solid {{ barwy.kreska }}; padding:18px 0 0 0;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td width="120" style="font-family:{{ kroj }}; font-size:13px; line-height:1.7; color:{{ barwy.podpis }};">Twój login</td>
              <td style="font-family:{{ kroj }}; font-size:13px; line-height:1.7; color:{{ barwy.tekst }};">{{ login }}</td>
            </tr>
            {% if zapraszajacy %}
            <tr>
              <td width="120" style="font-family:{{ kroj }}; font-size:13px; line-height:1.7; color:{{ barwy.podpis }};">Zaprosił</td>
              <td style="font-family:{{ kroj }}; font-size:13px; line-height:1.7; color:{{ barwy.tekst }};">{{ zapraszajacy }}</td>
            </tr>
            {% endif %}
          </table>
        </td></tr>
{% endblock %}

{% block stopka %}Nie spodziewałeś się tej wiadomości? Zignoruj ją — bez ustawienia hasła konto pozostaje nieaktywne.<br>
{% endblock %}
