{#- Lista aktywnych sesji konta (fragment htmx i część strony „Twoje urządzenia”).
    Zmienne: devices (handle, device, network, created_at, last_seen_at, current), revoked. -#}
{#- ⚠ `id` zostaje — to cel htmx (`hx-target="#devices"`). Klasa `devices` nie miała reguły
    w żadnym arkuszu, więc znika; nie jest hakiem, tylko nazwą bez treści. -#}
<div id="devices">
    {% if revoked %}
        {% include 'partials/komunikat.twig' with {'tekst': 'Wybrane sesje zakończone. Urządzenie wyloguje się przy następnym żądaniu.', 'rodzaj': 'sukces'} only %}
    {% endif %}
    {#- ⚠ Ta sama lista co wybór firmy i ustawienia konta — jeden komponent `.settings-list`.
        Różnica jest w sposobie klikania, nie w wyglądzie: tu wiersz NIE jest celem, bo akcja
        („Zakończ sesję") stoi w jego środku. Stan „to urządzenie" niosła zielona krawędź
        i plakietka; zostaje plakietka (§2). -#}
    <ul class="settings-list">
        {% for d in devices %}
            <li>
                <div class="settings-list__row">
                    <span class="settings-list__copy">
                        <strong>{{ d.device }}</strong>
                        <small>zalogowano {{ czas(d.created_at) }} · ostatnia aktywność {{ czas(d.last_seen_at) }}
                            {%- if d.network is not null %} · sieć {{ d.network }}{% endif %}</small>
                    </span>
                    {% if d.current %}<span class="chip">To urządzenie</span>{% endif %}
                    {% if not d.current %}
                        <form method="post" action="{{ url('/ustawienia/urzadzenia/zakoncz') }}"
                              hx-post="{{ url('/ustawienia/urzadzenia/zakoncz') }}" hx-target="#devices" hx-swap="outerHTML">
                            {% include 'partials/csrf.twig' %}
                            <input type="hidden" name="session" value="{{ d.handle }}">
                            <button type="submit" class="btn btn--ghost btn--sm">Zakończ sesję</button>
                        </form>
                    {% endif %}
                </div>
            </li>
        {% endfor %}
    </ul>
    <div class="btn-row">
        {#- Odświeżenie listy: zwykły odnośnik bez JS, fragment przez htmx. -#}
        <a class="btn btn--ghost btn--sm" href="{{ url('/ustawienia/urzadzenia') }}"
           hx-get="{{ url('/ustawienia/urzadzenia') }}" hx-target="#devices" hx-swap="outerHTML">Odśwież listę</a>
    {% if devices|length > 1 %}
        <form method="post" action="{{ url('/ustawienia/urzadzenia/zakoncz-pozostale') }}"
              hx-post="{{ url('/ustawienia/urzadzenia/zakoncz-pozostale') }}" hx-target="#devices" hx-swap="outerHTML">
            {% include 'partials/csrf.twig' %}
            <button type="submit" class="btn btn--danger btn--sm">Wyloguj wszystkie pozostałe urządzenia</button>
        </form>
    {% endif %}
    </div>
</div>
