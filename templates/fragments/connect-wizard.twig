{# Stan kreatora podłączenia: to samo, co na ekranie, policzone od nowa z bazy (CLAUDE.md §5).
   ⚠ Akcja każdego kroku stoi PRZY tym kroku — administrator nie ma szukać formularza niżej.
   ⚠ Odpytywanie chodzi WYŁĄCZNIE na krokach, na których czekamy na connectora, i niesie znacznik
   stanu: gdy nic się nie zmieniło, serwer odpowiada `204` i htmx NICZEGO nie podmienia — ekran nie
   mruga, a tekst wpisywany w polu nie znika. Gdy piłka jest po stronie administratora (nazwa klucza,
   decyzja o zgłoszeniu) albo wszystko jest gotowe, w podmienionym fragmencie nie ma już `hx-trigger`
   i odpytywanie kończy się samo, bez linii kodu w JS.
   Klucza pokazywanego raz TU NIE MA: zjadłoby go pierwsze odpytanie. #}
{% import 'partials/ikony.twig' as ikona %}
<div id="kreator-stan" class="stack stack--lg"{% if kreator.gotowe %} data-kreator-gotowe="1"{% endif %}
     hx-get="{{ url('/admin/podlaczenie/stan') }}?znacznik={{ znacznik|url_encode }}"
     hx-target="this"
     hx-swap="outerHTML"
     {% if kreator.czeka_na_connector %}hx-trigger="every 5s"{% endif %}>

    {% if komunikat is not null %}
        <p class="notice" role="status">{{ komunikat }}</p>
    {% endif %}

    {% if nowy_klucz is not null %}
        <div class="notice notice--warn">
            <p>Zobaczysz go tylko teraz. Skopiuj klucz i wklej go w konfiguracji connectora — w bazie zostaje wyłącznie jego skrót.</p>
        </div>
        <div class="secret">
            <div class="secret__row">
                <input class="secret__value mono" id="kreator-klucz" type="text" value="{{ nowy_klucz }}" readonly
                       aria-label="Klucz instalacji" autocomplete="off" spellcheck="false">
                <button type="button" class="btn btn--ghost" data-copy="kreator-klucz" data-copy-done="kreator-klucz-ok">Kopiuj</button>
                <span class="secret__done" id="kreator-klucz-ok" role="status" hidden>Skopiowano</span>
            </div>
        </div>
    {% endif %}

    <ol class="wizard">
        {% for krok in kreator.kroki %}
            <li class="wizard__step wizard__step--{{ krok.stan }}">
                <span class="wizard__mark" aria-hidden="true">{% if krok.stan == 'zrobione' %}{{ ikona.ptaszek() }}{% else %}{{ loop.index }}{% endif %}</span>
                <span class="wizard__name">{{ krok.nazwa }}</span>
                <span class="wizard__state">{% if krok.stan == 'zrobione' %}zrobione{% elseif krok.stan == 'biezacy' %}teraz{% else %}czeka{% endif %}</span>
                {% if krok.co_dalej is not null %}<p class="wizard__next">{{ krok.co_dalej }}</p>{% endif %}

                {% if krok.akcja == 'klucz' and krok.stan == 'biezacy' %}
                    <form method="post" action="{{ url('/admin/integracja/klucze') }}" class="wizard__form"
                          hx-post="{{ url('/admin/integracja/klucze') }}" hx-target="#kreator-stan" hx-swap="outerHTML">
                        {% include 'partials/csrf.twig' %}
                        <input type="hidden" name="wroc" value="kreator">
                        <label class="wizard__field">
                            <span>Nazwa klucza (do rozpoznania na liście)</span>
                            <input class="input" type="text" name="nazwa" maxlength="100" placeholder="np. serwer kadrowy w biurze" required autocomplete="off">
                        </label>
                        <button type="submit" class="btn btn--primary">Wygeneruj klucz</button>
                    </form>
                {% elseif krok.akcja == 'klucz' and krok.stan == 'zrobione' and klucz_id is not null %}
                    <form method="post" action="{{ url('/admin/integracja/klucze/' ~ klucz_id ~ '/nowy') }}" class="wizard__form"
                          hx-post="{{ url('/admin/integracja/klucze/' ~ klucz_id ~ '/nowy') }}" hx-target="#kreator-stan" hx-swap="outerHTML">
                        {% include 'partials/csrf.twig' %}
                        <input type="hidden" name="wroc" value="kreator">
                        <p class="wizard__hint">Klucz jest wydany. Jeśli przepadł i nie ma go w konfiguracji connectora, wygeneruj nowy — poprzedni zostanie natychmiast unieważniony.</p>
                        <button type="submit" class="btn btn--ghost btn--sm">Wygeneruj nowy klucz</button>
                    </form>
                {% endif %}

                {% if krok.akcja == 'firma' and krok.stan == 'biezacy' %}
                    {% if signups is not empty %}
                        <div class="wizard__form table-scroll">
                            <table class="table">
                                <thead><tr><th class="table__grow">Nazwa z programu kadrowego</th><th>NIP</th><th>Zgłoszono</th><th><span class="visually-hidden">Decyzja</span></th></tr></thead>
                                <tbody>
                                {% for s in signups %}
                                    <tr>
                                        <td class="table__grow">{{ s.name }}</td>
                                        <td class="table__mute mono">{{ nip_grupami(s.nip) }}</td>
                                        <td class="table__mute">{{ czas(s.created_at) }}</td>
                                        <td>
                                            <div class="btn-row">
                                                <form method="post" action="{{ url('/admin/integracja/zgloszenia/' ~ s.id ~ '/zatwierdz') }}"
                                                      hx-post="{{ url('/admin/integracja/zgloszenia/' ~ s.id ~ '/zatwierdz') }}" hx-target="#kreator-stan" hx-swap="outerHTML">
                                                    {% include 'partials/csrf.twig' %}
                                                    <input type="hidden" name="wroc" value="kreator">
                                                    <button type="submit" class="btn btn--primary btn--sm">Zatwierdź</button>
                                                </form>
                                                <form method="post" action="{{ url('/admin/integracja/zgloszenia/' ~ s.id ~ '/odrzuc') }}"
                                                      hx-post="{{ url('/admin/integracja/zgloszenia/' ~ s.id ~ '/odrzuc') }}" hx-target="#kreator-stan" hx-swap="outerHTML">
                                                    {% include 'partials/csrf.twig' %}
                                                    <input type="hidden" name="wroc" value="kreator">
                                                    <button type="submit" class="btn btn--ghost btn--sm">Odrzuć</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <p class="wizard__hint">Nic tu nie trzeba wpisywać ręcznie — zgłoszenie pojawi się w tym miejscu samo, gdy connector wyśle firmę.</p>
                    {% endif %}
                {% endif %}
            </li>
        {% endfor %}
    </ol>

    {% if firmy is not empty %}
        <p class="field__hint">Firmy obsługiwane przez tę instalację:
            {% for f in firmy %}{{ f.name }} ({{ nip_grupami(f.nip) }}){% if not loop.last %}, {% endif %}{% endfor %}.</p>
    {% endif %}

    <div class="defs">
        <div><div class="defs__term">Ostatnie połączenie connectora</div><div class="defs__value">{{ czas_wzgledny(ostatnie_polaczenie) }}</div></div>
        <div><div class="defs__term">Wersja connectora</div><div class="defs__value">{{ wersja_connectora ?? '—' }}</div></div>
        <div><div class="defs__term">Ostatnia synchronizacja</div><div class="defs__value">{{ czas_wzgledny(podsumowanie.ostatnia_synchronizacja) }}</div></div>
        <div><div class="defs__term">Pracownicy / nieobecności</div><div class="defs__value">{{ podsumowanie.pracownicy }} / {{ podsumowanie.nieobecnosci }}</div></div>
    </div>

    <div class="btn-row">
        {# Bez JavaScriptu ten odnośnik jest jedynym sposobem odświeżenia — i wystarcza. #}
        <a class="btn btn--ghost btn--sm" href="{{ url('/admin/podlaczenie') }}"
           hx-get="{{ url('/admin/podlaczenie/stan') }}" hx-target="#kreator-stan" hx-swap="outerHTML">Odśwież teraz</a>
        {% if kreator.czeka_na_connector %}
            <span class="wizard__state">czekam na connectora — sprawdzam co 5 sekund</span>
        {% endif %}
    </div>

    {% if kreator.gotowe %}
        <p class="notice" role="status">Gotowe — connector dowiózł dane. Ostatnia synchronizacja
            {{ czas(podsumowanie.ostatnia_synchronizacja) }}, {{ podsumowanie.pracownicy }} pracowników,
            {{ podsumowanie.nieobecnosci }} nieobecności.</p>
    {% endif %}
</div>
