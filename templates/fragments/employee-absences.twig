{# Karta nieobecności jako fragment (docs/system-wizualny.md §5.8).
   ⚠ Odnośniki ZOSTAJĄ odnośnikami: `href` działa bez JavaScriptu i przy otwarciu w nowej karcie,
   a htmx tylko przechwytuje kliknięcie i wymienia tę jedną kartę. `hx-push-url` utrzymuje adres,
   więc odświeżenie strony pokazuje ten sam rok.
   ⚠ Endpoint fragmentu sprawdza zalogowanie, uprawnienie i przynależność osoby do firm użytkownika
   dokładnie tak samo jak pełny ekran (CLAUDE.md §5). #}
<section class="card" id="nieobecnosci">
        <div class="card__head card__head--znak card__head--lista">
            {#- ⚠ `{% import %}` jest LOKALNY dla szablonu — ten fragment bywa renderowany SAM
                (odpowiedź htmx po przełączeniu roku), więc musi importować ikony u siebie.
                Bez tej linii przełączenie roku kończyło się błędem „Variable ikony does not exist",
                czyli kartą, która znikała po kliknięciu. -#}
            {% import 'partials/ikony.twig' as ikony %}
            <span class="card__znak">{{ ikony.kartka_kalendarza() }}</span>
            <div class="card__tytuly">
                <h2 class="card__title">Nieobecności</h2>
                <p class="card__opis">Okresy z programu kadrowego.</p>
            </div>
            {# ⚠ Przyciski to lata, w których ta osoba NAPRAWDĘ ma nieobecności — bez slice'a
               i bez zakładania, które lata istnieją. Przy jednym roku nie ma czego przełączać. #}
            {% if lata|length > 1 %}
                <div class="segmented">
                    {% for l in lata %}
                        <a class="segmented__item{{ zakres == l ? ' segmented__item--on' : '' }}" href="{{ url('/dane/pracownik/' ~ osoba.id) }}?rok={{ l }}" hx-get="{{ url('/dane/pracownik/' ~ osoba.id ~ '/nieobecnosci') }}?rok={{ l }}" hx-target="#nieobecnosci" hx-swap="outerHTML show:none" hx-push-url="{{ url('/dane/pracownik/' ~ osoba.id) }}?rok={{ l }}">{{ l }}</a>
                    {% endfor %}
                    <a class="segmented__item{{ zakres is null ? ' segmented__item--on' : '' }}" href="{{ url('/dane/pracownik/' ~ osoba.id) }}?rok=wszystkie" hx-get="{{ url('/dane/pracownik/' ~ osoba.id ~ '/nieobecnosci') }}?rok=wszystkie" hx-target="#nieobecnosci" hx-swap="outerHTML show:none" hx-push-url="{{ url('/dane/pracownik/' ~ osoba.id) }}?rok=wszystkie">wszystkie</a>
                </div>
            {% endif %}
        </div>
        <div class="table-scroll">
            {#- ⚠ Bez zebry (Z46 §5): rodzaj niesie plakietka w barwach pasków kalendarza, więc
                pasy w co drugim wierszu dokładały drugi rytm do tego samego wiersza. -#}
        <table class="table table--nieobecnosci">
                <thead>
                    <tr><th class="table__grow">Rodzaj</th><th>Od</th><th>Do</th><th class="table__num">Dni robocze</th><th>Źródło</th></tr>
                </thead>
                <tbody>
                {% set poprzedni_rok = null %}
                {% for n in nieobecnosci %}
                    {% if zakres is null and n.from|slice(0, 4) != poprzedni_rok %}
                        <tr class="table__group"><td colspan="5">{{ n.from|slice(0, 4) }}</td></tr>
                        {% set poprzedni_rok = n.from|slice(0, 4) %}
                    {% endif %}
                    <tr>
                        <td class="table__grow" data-kolumna="Rodzaj">
                            {#- ⚠ Barwa plakietki idzie za ŹRÓDŁEM rodzaju z R2 (`urlop`, `zasilek`,
                                `kadrowe`) — tymi samymi trzema barwami, co paski w kalendarzu, żeby
                                ta sama nieobecność miała ten sam kolor na obu ekranach.
                                ⚠ Modyfikator z jawnego warunku, nigdy sklejany z danych
                                (`chip--{{ n.type_source }}`, §4b): pierwsze nowe źródło rodzaju
                                wytworzyłoby klasę, której system nie ma. -#}
                            {% if n.type_source == 'urlop' %}<span class="chip chip--urlop">{{ n.type }}</span>
                            {% elseif n.type_source == 'zasilek' %}<span class="chip chip--zwolnienie">{{ n.type }}</span>
                            {% else %}<span class="chip chip--kadrowe">{{ n.type }}</span>{% endif %}
                            {#- ⚠ Jedno słowo na jedną rzecz: stopka mówi „wycofanych", więc plakietka też mówi
                                „wycofana" (do 10.10.2026 stało tu „usunięta" i ta sama rzecz miała
                                na jednym ekranie dwie nazwy — „usunięta" brzmi jak decyzja kadrowej,
                                a to R2 przestało tę nieobecność przysyłać). -#}
                            {% if n.removed %} <span class="chip">wycofana</span>{% endif %}
                            {% if n.out_of_window %} <span class="chip">poza oknem</span>{% endif %}
                        </td>
                        <td class="table__mute table__num--data" data-kolumna="Od">{{ data_dnia(n.from) }}</td>
                        <td class="table__mute table__num--data" data-kolumna="Do">{{ data_dnia(n.to) }}</td>
                        <td class="table__num" data-kolumna="Dni robocze" title="{{ czas_minuty(n.minutes) }}">
                            {{ n.days is null ? '—' : n.days }}{% if n.type_source == 'kadrowe' %} <span class="chip" title="Program kadrowy nie wylicza długości dla tego źródła">liczy 0</span>{% endif %}
                        </td>
                        {# ⚠ Źródło rozróżnia to, co wjechało z kadr, od tego, co wyszło od nas (§5.2). #}
                        <td class="table__zrodlo" data-kolumna="Źródło">{% if n.source == 'connector' %}<span class="chip chip--accent">wniosek w wezurlop</span>{% else %}R2 Płatnik{% endif %}</td>
                    </tr>
                {% else %}
                    {# ⚠ Neutralnie: najczęstszy powód pustej tabeli to brak urlopu, nie awaria synchronizacji. #}
                    <tr><td colspan="5" class="table__empty">Brak nieobecności w danych z kadr.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="card__foot">
            {#- ⚠ Liczba **obowiązujących** i osobno **wycofanych** (10.10.2026): tabela pokazuje
                jedne i drugie, więc stopka z jedną liczbą nie zgadzała się z tym, co widać nad nią.
                Zmierzone: osoba z 19 wycofanymi nieobecnościami miała w stopce „19 nieobecności
                · 76 dni roboczych", a w kadrach ani jednego dnia. -#}
            {#- ⚠ **Odmiana z jednego miejsca** (`Support\Odmiana`, naprawa 20.10.2026 — pozycja 89
                z `do-sprawdzenia.md`). Stało tu wpisane na sztywno „dni roboczych" dla każdej
                liczby, czyli „1 dni roboczych" i „23 dni roboczych" zamiast „1 dzień roboczy"
                i „23 dni robocze". Trzecia forma polskiego liczebnika nie jest wyjątkiem
                od reguły — jest regułą, i ma jedno miejsce w kodzie. Liczba nieobecności idzie
                tą samą drogą (`odmiana_nieobecnosci`). -#}
            <span>{{ podsumowanie_nieobecnosci.liczba }} {{ odmiana_nieobecnosci(podsumowanie_nieobecnosci.liczba) }} · {{ podsumowanie_nieobecnosci.dni }} {{ odmiana_dni_robocze(podsumowanie_nieobecnosci.dni) }}{% if podsumowanie_nieobecnosci.wycofanych > 0 %} · <strong>wycofanych: {{ podsumowanie_nieobecnosci.wycofanych }}</strong> (w tabeli, nieliczone){% endif %}{% if zakres is null and lata|length > 1 %} · lata {{ lata|join(', ') }}{% endif %}{% if przyciete %} · pokazujemy {{ pokazano_najwyzej }} najnowszych — wybierz rok, żeby zobaczyć starsze{% endif %}</span>
            {% if strona.stron > 1 %}
                <div class="btn-row">
                    {% if strona.numer > 1 %}
                        <a class="btn btn--ghost btn--sm" href="{{ url('/dane/pracownik/' ~ osoba.id) }}?rok={{ zakres ?? 'wszystkie' }}&amp;strona={{ strona.numer - 1 }}" hx-get="{{ url('/dane/pracownik/' ~ osoba.id ~ '/nieobecnosci') }}?rok={{ zakres ?? 'wszystkie' }}&amp;strona={{ strona.numer - 1 }}" hx-target="#nieobecnosci" hx-swap="outerHTML show:none" hx-push-url="{{ url('/dane/pracownik/' ~ osoba.id) }}?rok={{ zakres ?? 'wszystkie' }}&amp;strona={{ strona.numer - 1 }}">Poprzednie</a>
                    {% endif %}
                    {% if strona.numer < strona.stron %}
                        <a class="btn btn--ghost btn--sm" href="{{ url('/dane/pracownik/' ~ osoba.id) }}?rok={{ zakres ?? 'wszystkie' }}&amp;strona={{ strona.numer + 1 }}" hx-get="{{ url('/dane/pracownik/' ~ osoba.id ~ '/nieobecnosci') }}?rok={{ zakres ?? 'wszystkie' }}&amp;strona={{ strona.numer + 1 }}" hx-target="#nieobecnosci" hx-swap="outerHTML show:none" hx-push-url="{{ url('/dane/pracownik/' ~ osoba.id) }}?rok={{ zakres ?? 'wszystkie' }}&amp;strona={{ strona.numer + 1 }}">Następne</a>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </section>
