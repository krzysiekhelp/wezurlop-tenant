{% extends 'layout/web.twig' %}

{% block nazwa_ekranu %}Dziennik zdarzeń{% endblock %}

{% block okruchy %}
{% endblock %}

{% block content %}
{% import 'partials/ikony.twig' as ikony %}
{% import 'partials/ikona-zdarzenia.twig' as znak %}
{#- ⚠ **Bez `.page__head` i bez linii „Wynik: X z Y"** (zlecenie Z36 §1): liczba wpisów stoi
    w nagłówku karty, a „wynik" powtarzał to, co widać na liście i w stopce. Tytułu karta nie ma —
    „Dziennik zdarzeń" jest w belce, a jeden ekran ma jeden tytuł. -#}

    <section class="card">
        <div class="card__head card__head--znak card__head--lista">
            <span class="card__znak">{{ ikony.wnioski() }}</span>
            <div class="card__tytuly">
                <p class="card__opis card__opis--lead">Wszystkie ważne operacje w aplikacji. Wpisów nie da się zmienić ani usunąć.</p>
                <p class="card__opis">{{ strona.razem }} {{ odmiana_wpisow(strona.razem) }} · czasy w strefie {{ strefa_tenanta() }}</p>
            </div>
            {#- Filtr konta: zwykły formularz GET, działa bez JavaScriptu i daje adres do wklejenia (§5).
                ⚠ Etykieta zostaje dla czytnika ekranu (`aria-label`), choć nie widać jej na ekranie:
                pole wyboru bez nazwy jest dla czytnika „combo box" i niczym więcej. -#}
            <form class="card__akcje dz-wybor" method="get" action="{{ url('/admin/dziennik') }}">
                {#- ⚠ Rodzaj był tu dotąd polem UKRYTYM, a wybierało się go paskiem siedmiu chipów
                    nad listą (Z36). Od Z42 jest zwykłą listą rozwijaną obok konta: oba filtry
                    stoją w jednym formularzu, oba stosuje ten sam przycisk „Pokaż" i oba dalej
                    działają bez JavaScriptu. -#}
                <select class="select" name="rodzaj" aria-label="Rodzaj zdarzeń">
                    <option value="">wszystkie zdarzenia</option>
                    {% for r in rodzaje %}
                        <option value="{{ r.klucz }}"{{ rodzaj == r.klucz ? ' selected' : '' }}>{{ r.nazwa }}</option>
                    {% endfor %}
                </select>
                <select class="select" name="konto" aria-label="Konto, którego dotyczą wpisy">
                    <option value="">wszystkie konta</option>
                    {% for k in konta %}
                        <option value="{{ k.id }}"{{ konto == k.id ? ' selected' : '' }}>{{ k.nazwa }}</option>
                    {% endfor %}
                </select>
                <button type="submit" class="btn btn--akcja">Pokaż</button>
            </form>
        </div>

        <ul class="dz-lista">
            {% for w in wpisy %}
                {#- Nagłówek dnia przed pierwszym wpisem z danego dnia. ⚠ Porównujemy DATĘ W STREFIE
                    TENANTA (ta sama funkcja, która ją wyświetla), a nie znacznik UTC: inaczej dzień
                    łamałby się o północy UTC, czyli w środku popołudnia u klienta za oceanem. -#}
                {% if loop.first or czas_data(w.kiedy) != czas_data(wpisy[loop.index0 - 1].kiedy) %}
                    <li class="dz-dzien">{{ czas_dzien_naglowek(w.kiedy) }}</li>
                {% endif %}
                {#- ⚠ Kod zdarzenia i surowe szczegóły są W `title` WIERSZA, nie w treści (Z36 §4):
                    zdanie jest tłumaczeniem, a przy sporze liczy się kod. -#}
                <li class="dz-wpis" title="{{ w.kod }}{% for s in w.szczegoly %} · {{ s.klucz }}: {{ s.wartosc }}{% endfor %}">
                    <span class="dz-znak dz-znak--{{ w.zdanie.barwa }}" aria-hidden="true">{{ znak.rodzaj(w.zdanie.ikona) }}</span>
                    <span class="dz-tresc">
                        <span class="dz-zdanie">
                            {#- Kto — pogrubiony, bo od niego zaczyna się każde pytanie do dziennika.
                                Odnośnik filtruje dziennik na to konto; bez konta zostaje sam napis. -#}
                            {%- if w.kto_konto %}<a class="dz-kto" href="{{ url('/admin/dziennik') }}?konto={{ w.kto_konto }}{% if rodzaj is not null %}&amp;rodzaj={{ rodzaj }}{% endif %}">{{ w.zdanie.kto }}</a>
                            {%- else %}<strong class="dz-kto">{{ w.zdanie.kto }}</strong>{% endif %}
                            {#- ⚠ Spacja jawnie, bo `{%- %}` zjada białe znaki: bez niej wychodziło
                                „Jan Kowalskizalogował(a) się". -#}
                            {{- ' ' -}}
                            {%- for c in w.zdanie.czesci %}{% if c.mocno %}<strong>{{ c.t }}</strong>{% else %}{{ c.t }}{% endif %}{% endfor %}
                        </span>
                        {% if w.spolka %}<span class="dz-firma">{{ w.spolka }}</span>{% endif %}
                    </span>
                    {#- Godzina JEDNĄ czcionką, z sekundami i bez pogrubień (Z36 §4): w audycie
                        sekunda bywa treścią, a zmniejszanie jej części udawałoby, że jest dodatkiem. -#}
                    <span class="dz-czas">{{ czas_godzina(w.kiedy) }}</span>
                </li>
            {% else %}
                <li class="dz-pusto">{{ konto or rodzaj is not null ? 'Nic nie pasuje do wybranych filtrów.' : 'Dziennik jest pusty.' }}</li>
            {% endfor %}
        </ul>

        <div class="card__foot">
            <span class="dz-podsumowanie">Pokazano {{ strona.razem > 0 ? strona.offset + 1 : 0 }}–{{ strona.offset + wpisy|length }} z {{ strona.razem }}</span>
            {#- ⚠ Przyciski stronicowania stoją ZAWSZE, nieczynny jest wyszarzony (Z36 §6):
                znikający przycisk przesuwa drugi na swoje miejsce i przy klikaniu „Starsze"
                trafia się w „Nowsze". `aria-disabled` plus brak `href` — bez JavaScriptu. -#}
            <div class="btn-row btn-row--jedna-linia">
                {% if strona.numer > 1 %}
                    <a class="btn btn--akcja" href="{{ url('/admin/dziennik') }}?strona={{ strona.numer - 1 }}{% if konto %}&amp;konto={{ konto }}{% endif %}{% if rodzaj is not null %}&amp;rodzaj={{ rodzaj }}{% endif %}">‹ Nowsze</a>
                {% else %}
                    <span class="btn btn--akcja btn--akcja-nieczynny" aria-disabled="true">‹ Nowsze</span>
                {% endif %}
                {% if strona.numer < strona.stron %}
                    <a class="btn btn--akcja" href="{{ url('/admin/dziennik') }}?strona={{ strona.numer + 1 }}{% if konto %}&amp;konto={{ konto }}{% endif %}{% if rodzaj is not null %}&amp;rodzaj={{ rodzaj }}{% endif %}">Starsze wpisy ›</a>
                {% else %}
                    <span class="btn btn--akcja btn--akcja-nieczynny" aria-disabled="true">Starsze wpisy ›</span>
                {% endif %}
            </div>
        </div>
    </section>
{% endblock %}
