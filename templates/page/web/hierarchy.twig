{% extends 'layout/web.twig' %}

{#- Przeciąganie kart to jedyny ekran, który potrzebuje tego modułu JS. -#}
{% set hierarchia = true %}

{% block nazwa_ekranu %}Hierarchia{% endblock %}

{% block okruchy %}
{% endblock %}

{% block content %}
{% import 'partials/ikony.twig' as ikony %}
{#- ⚠ **Bez `.page__head`** (zlecenie Z34 §1): nazwa firmy zeszła do podpisu pierwszego kafla,
    bo to ona mówi, czego dotyczą liczby, a zdanie o „wszystkich spółkach" zniknęło — administrator
    tenanta i tak widzi w belce, którą firmę prowadzi. Zdanie o tym, czym jest hierarchia, stoi
    teraz w nagłówku prawego panelu, przy strukturze, której dotyczy. -#}

    {% include 'partials/komunikat.twig' with {'tekst': error, 'rodzaj': 'blad'} only %}
    {% include 'partials/komunikat.twig' with {'tekst': notice, 'rodzaj': 'sukces'} only %}

    {% if spolka is null %}
        <p class="empty-state">To konto nie ma firmy, w której mogłoby ustawiać strukturę. Hierarchię prowadzi się w obrębie firmy, do której masz dostęp.</p>
    {% else %}
        {#- ⚠ Pasek kafli — ten sam komponent, co na pulpicie, `/ustawienia`, `/admin/konta`
            i `/admin/grupy` (`.kafle--auto`). Zastąpił `.card.stats` (Z34 §2).

            ⚠ **„Bez przełożonego" i „Na szczycie" to DWIE różne liczby** i tylko pierwsza jest
            do zrobienia — to cały powód, dla którego szczyt jest jawną decyzją.

            ⚠ Atrybuty `data-hier-liczba` zostają: `modules/hierarchia.js` przelicza te liczby
            po każdym przeciągnięciu, bez przeładowania ekranu. Zmienił się tylko znacznik
            i nazwa klasy odchylenia, nie mechanizm. -#}
        <section class="kafle kafle--auto" aria-label="Stan struktury firmy">
            <div class="kafel">
                <span class="kafel__glowa">{{ ikony.zespol() }}<span class="kafel__etykieta">Zatrudnionych w firmie</span></span>
                <span class="kafel__dana">
                    <span class="kafel__wartosc" data-hier-liczba="zatrudnionych">{{ struktura.liczby.zatrudnionych }}</span>
                    {#- Dopiski o firmie z adresu i o firmie poza zakresem zostają: bez nich znacznik
                        w belce i liczba na ekranie mówiłyby co innego, bez wyjaśnienia dlaczego. -#}
                    <span class="kafel__opis">w firmie {{ spolka.nazwa }}{% if z_adresu %} (firma z adresu, na jedno wyświetlenie){% elseif fallback %} (firma z belki jest poza zakresem tego ekranu){% endif %}</span>
                </span>
            </div>
            <div class="kafel">
                <span class="kafel__glowa">{{ ikony.osoba_bez() }}<span class="kafel__etykieta">Bez przełożonego</span></span>
                <span class="kafel__dana">
                    {#- ⚠ Odchylenie to KOLOR WARTOŚCI, nie plakietka: liczba ma zostać liczbą
                        tej samej wielkości co pozostałe. -#}
                    <span class="kafel__wartosc{{ struktura.liczby.nieustawionych > 0 ? ' kafel__wartosc--odchylenie' : '' }}"
                          data-hier-liczba="nieustawionych">{{ struktura.liczby.nieustawionych }}</span>
                    <span class="kafel__opis">do przypisania w strukturze</span>
                </span>
            </div>
            <div class="kafel">
                <span class="kafel__glowa">{{ ikony.drzewo() }}<span class="kafel__etykieta">Na szczycie hierarchii</span></span>
                <span class="kafel__dana">
                    <span class="kafel__wartosc" data-hier-liczba="szczytow">{{ struktura.liczby.szczytow }}</span>
                    <span class="kafel__opis">nie podlegają nikomu</span>
                </span>
            </div>
            <div class="kafel">
                <span class="kafel__glowa">{{ ikony.prostokaty() }}<span class="kafel__etykieta">Najgłębszy poziom</span></span>
                <span class="kafel__dana">
                    <span class="kafel__wartosc" data-hier-liczba="najglebszy">{{ struktura.liczby.najglebszy }}</span>
                    <span class="kafel__opis">poziomy podległości</span>
                </span>
            </div>
            <div class="kafel">
                <span class="kafel__glowa">{{ ikony.klodka() }}<span class="kafel__etykieta">Wymaga uwagi</span></span>
                <span class="kafel__dana">
                    <span class="kafel__wartosc{{ struktura.liczby.uwagi > 0 ? ' kafel__wartosc--odchylenie' : '' }}"
                          data-hier-liczba="uwagi">{{ struktura.liczby.uwagi }}</span>
                    {#- ⚠ Podpis mówi, CZEGO liczba nie liczy, i mówi to w kaflu, którego dotyczy:
                        przy nieznanej roli przełożonego liczy wyłącznie zablokowane konta. -#}
                    <span class="kafel__opis">
                        {{- struktura.liczby.uwagi == 0 ? 'brak problemów w strukturze'
                            : (struktura.rola_znana ? 'zablokowane konta i brak roli przełożonego' : 'zablokowane konta') -}}
                    </span>
                </span>
            </div>
        </section>

        <div class="hier">
            <section class="card hier__panel">
                {#- ⚠ Nagłówek ze znakiem w barwie OSTRZEŻENIA (Z34 §4): ten panel jest listą zadań,
                    a nie zestawieniem — dopóki ktoś tu stoi, jego wniosek nie ma do kogo pójść.
                    Zdanie przeniosło się z akapitu pod nagłówkiem do samego nagłówka, bo mówi,
                    czym jest ta lista, a nie co z nią zrobić. -#}
                <div class="card__head card__head--znak">
                    <span class="card__znak card__znak--uwaga">{{ ikony.osoba_bez() }}</span>
                    <div class="card__tytuly">
                        <h2 class="card__title">Bez przełożonego</h2>
                        <p class="card__opis">Tu trafia każdy nowy pracownik z programu kadrowego. Przeciągnij go na kartę przełożonego w strukturze.</p>
                    </div>
                    <span class="chip chip--warn hier__licznik">{{ struktura.liczby.nieustawionych }} z {{ struktura.liczby.zatrudnionych }}</span>
                </div>
                <div class="card__body">
                    {#- ⚠ Kontrolki filtrowania są UKRYTE bez JavaScriptu (`hidden` zdejmuje je
                        z układu), bo bez niego nie mają czego filtrować — a przycisk, który nic
                        nie robi, jest gorszy od jego braku. Bez JS zostaje pełna lista i ścieżka
                        „⋯": degradacja, nie awaria. -#}
                    <label class="field pole-szukania" id="hier-filtr-panel" hidden>
                        <span class="field__label visually-hidden">Szukaj osoby bez przełożonego</span>
                        {{ ikony.lupa() }}
                        <input class="input" type="search" data-hier-filtr="hier-nieustawieni" maxlength="100"
                               placeholder="szukaj osoby bez przełożonego">
                    </label>
                    {#- ⚠ Filtr MUSI mówić, ilu ukrył: panel pusty z powodu filtra i panel pusty,
                        bo robota skończona, nie mają prawa wyglądać tak samo — a to jedyny
                        licznik na tym ekranie, który jest listą zadań. -#}
                    <p class="field__hint" data-hier-ukryte="hier-nieustawieni" hidden></p>
                    {#- ⚠ Karta owinięta w `li.hier__node` TAK SAMO jak w drzewie. Dwa powody,
                        oba zmierzone: `<ul>` z dzieckiem innym niż `<li>` to niepoprawny HTML,
                        a uchwyt przeciągania szuka najbliższego `.hier__node` — bez niego karty
                        z tego panelu w ogóle nie dawały się przeciągnąć (pasek zmian zostawał
                        pusty przy poprawnym zdarzeniu `drop`). -#}
                    <ul class="hier__list" id="hier-nieustawieni" data-hier-drop="zdejmij">
                        {% for w in struktura.nieustawieni %}
                            <li class="hier__node">
                                {% include 'partials/page/hierarchy-card.twig' with {'w': w, 'spolka': spolka} only %}
                            </li>
                        {% endfor %}
                    </ul>
                    {% if struktura.nieustawieni is empty %}
                        <p class="empty-state">Nikogo — każde zatrudnienie ma rozstrzygniętą pozycję.</p>
                    {% else %}
                        <p class="hier__drop hier__drop--panel">{{ ikony.strzalka_w_dol() }}Upuść tutaj, żeby zdjąć ze struktury</p>
                    {% endif %}
                </div>
            </section>

            <section class="card hier__tree">
                <div class="card__head card__head--znak">
                    <span class="card__znak">{{ ikony.drzewo() }}</span>
                    <div class="card__tytuly">
                        <h2 class="card__title">Struktura</h2>
                        <p class="card__opis">Przeciągnij kartę na kartę osoby, która ma być przełożonym.</p>
                    </div>
                </div>
                <div class="card__body">
                    <div class="toolbar" id="hier-narzedzia" hidden>
                        <label class="field pole-szukania">
                            <span class="field__label visually-hidden">Szukaj w strukturze</span>
                            {{ ikony.lupa() }}
                            <input class="input" type="search" data-hier-filtr="hier-drzewo" maxlength="100" placeholder="szukaj w strukturze">
                        </label>
                        {#- Stanu zwinięcia nie zapamiętujemy między wejściami — żadnego
                            ustawienia użytkownika na coś, co jest wygodą jednego spojrzenia. -#}
                        <button type="button" class="btn btn--ghost btn--akcja" id="hier-zwin">Zwiń wszystko</button>
                        <button type="button" class="btn btn--ghost btn--akcja" id="hier-rozwin">Rozwiń wszystko</button>
                        <span class="toolbar__spacer"></span>
                        <span class="toolbar__result" data-hier-ukryte="hier-drzewo"></span>
                    </div>
                    {#- ⚠ §5: wariantu mobilnego tego ekranu NIE MA i nie będzie, ale człowiek,
                        który ciągnie kartę palcem i nic się nie dzieje, zgłasza usterkę.
                        Jedno zdanie zamiast planszy — ścieżka „⋯" działa dalej. -#}
                    <p class="notice hier__tylko-komputer" role="status">Ten ekran jest przeznaczony na komputer — przeciąganie kart nie działa palcem. Strukturę ustawisz menu (trzy kropki) przy karcie.</p>
                    {#- ⚠ Strefa upuszczania z ikoną i przerywaną ramką (Z34 §5): bez znaku czytało
                        się to jak zdanie informacyjne, a to jest CEL upuszczenia. -#}
                    <p class="hier__drop" data-hier-drop="szczyt">{{ ikony.strzalka_w_dol() }}Upuść tutaj, żeby osoba nie podlegała nikomu (szczyt struktury)</p>
                    {% if struktura.wezly is empty %}
                        <p class="empty-state">W tej firmie nie ma czynnych zatrudnień.</p>
                    {% else %}
                        <div id="hier-drzewo">
                            {% include 'partials/page/hierarchy-branch.twig' with {
                                'wezly': struktura.wezly, 'rodzic': null, 'spolka': spolka, 'poziom': 1
                            } only %}
                        </div>
                    {% endif %}
                </div>
            </section>
        </div>

        {#- Pasek zmian. ⚠ Przeciągnięcie NICZEGO nie zapisuje: jedno nieuważne upuszczenie
            przestawia ścieżkę akceptacji całemu zespołowi, a skutek widać dopiero wtedy, gdy
            czyjś wniosek pójdzie nie tam. Bez JavaScriptu pasek jest pusty i niewidoczny —
            wtedy zapisuje się pojedynczo, menu „⋯" przy karcie. -#}
        <form class="hier__bar" id="hier-bar" method="post" action="{{ url('/admin/hierarchia/zapisz') }}" hidden>
            {% include 'partials/csrf.twig' %}
            <input type="hidden" name="spolka" value="{{ spolka.id }}">
            <div class="hier__bar-text">
                <strong id="hier-bar-count">0 zmian</strong>
                <ul class="hier__bar-list" id="hier-bar-list"></ul>
            </div>
            <div class="hier__bar-actions">
                <button type="button" class="btn btn--ghost" id="hier-undo">Cofnij ostatnią</button>
                <button type="button" class="btn btn--ghost" id="hier-discard">Odrzuć wszystkie</button>
                <button type="submit" class="btn btn--primary">Zapisz zmiany</button>
            </div>
        </form>
        {#- ⚠ Istniejący komponent `.modal` (ten sam co na `/admin/konta` i `/admin/integracja`),
            nie nowy: tło, `Escape`, ognisko i wspólna obsługa `data-modal-open` są już zrobione.
            Treść dociąga htmx dopiero przy otwarciu — zamknięte okno nie odpytuje serwera. -#}
        <dialog id="hier-modal" class="modal" aria-labelledby="hier-modal-title" role="dialog" aria-modal="true">
            <div class="modal__head">
                <h3 id="hier-modal-title">Zmień przełożonego</h3>
                <button type="button" class="modal__close" data-modal-close="hier-modal" aria-label="Zamknij okno">×</button>
            </div>
            <div class="modal__body" id="hier-modal-tresc"></div>
        </dialog>
    {% endif %}
{% endblock %}
