{% extends 'layout/web.twig' %}

{% block nazwa_ekranu %}Dane z kadr{% endblock %}

{#- ⚠ **Układ z 19.10.2026 (zlecenie Z44, prototyp zaakceptowany w Chrome).** Co się zmieniło
    i dlaczego:
      — `.page__head` znika: zdanie o ekranie zeszło do nagłówka karty, której dotyczy,
        a „Stan synchronizacji" stanął przy liście, do której się odnosi,
      — cztery dane o stanie (firmy, pracownicy, ostatnia synchronizacja, tryb) stoją w pasku
        kafli, czytane obok siebie, zamiast być przemilczane albo rozsypane po tabeli,
      — tabela sześciu kolumn ustąpiła liście wierszy: przy 1440 px wychodziła 10 px za kartę,
        a NIP, stan zgłoszenia i nazwa klucza są przy firmie PLAKIETKAMI, nie kolumnami —
        kolumna „Klucz connectora" z napisem „— brak aktywnego klucza" była najszersza na ekranie
        i mówiła najmniej. -#}
{% block content %}
{% import 'partials/ikony.twig' as ikony %}

    {% if podwojne_osoby is not null %}
        {# ⚠ Bez słowa „odcisk”: to ekran kadrowej. Mówimy, co z tego wynika dla danych, a szczegóły
           techniczne zostają na ekranie integracji. #}
        <p class="notice notice--warn">Część osób może być tu widoczna podwójnie — dwie instalacje connectora obsługują firmy tego samego klucza.
            Osób zatrudnionych w więcej niż jednej firmie: <strong>{{ podwojne_osoby.osob }}</strong>.
            Szczegóły i sposób naprawy: <a href="{{ url('/admin/integracja') }}">Integracja z programem kadrowym</a>.</p>
    {% endif %}

    {#- ══════════ Pasek kafli (§2 zlecenia) ══════════
        ⚠ Liczby pochodzą z tej samej tablicy, co wiersze niżej (kontroler) — kafel „Pracownicy"
        jest sumą liczb, które widać pod nim, a nie drugim zapytaniem o to samo. -#}
    <section class="kafle kafle--auto" aria-label="Stan danych z kadr">
        <div class="kafel">
            <span class="kafel__glowa">{{ ikony.firma() }}<span class="kafel__etykieta">Firmy</span></span>
            <span class="kafel__dana">
                <span class="kafel__wartosc">{{ podsumowanie.firm }}</span>
                <span class="kafel__opis">z programu kadrowego</span>
            </span>
        </div>
        <div class="kafel">
            {#- ⚠ „Zatrudnienia", nie „Pracownicy" (decyzja po odbiorze Z44): ta liczba sumuje
                CZYNNE ZATRUDNIENIA, więc osoba zatrudniona w dwóch firmach jest w niej dwa razy.
                Etykieta „Pracownicy" obiecywała liczbę ludzi, a podpis „we wszystkich firmach"
                tej obietnicy nie odwoływał. -#}
            <span class="kafel__glowa">{{ ikony.zespol() }}<span class="kafel__etykieta">Zatrudnienia</span></span>
            <span class="kafel__dana">
                <span class="kafel__wartosc">{{ podsumowanie.pracownikow }}</span>
                <span class="kafel__opis">we wszystkich firmach</span>
            </span>
        </div>
        <div class="kafel">
            <span class="kafel__glowa">{{ ikony.odswiezenie() }}<span class="kafel__etykieta">Ostatnia synchronizacja</span></span>
            <span class="kafel__dana">
                {% if podsumowanie.ostatnia_sync is null %}
                    <span class="kafel__wartosc kafel__wartosc--brak">jeszcze nie było</span>
                {% else %}
                    {#- Czas WZGLĘDNY w danej, bezwzględny w znaczniku wiersza niżej — tak samo
                        jak w kolumnie „Ostatnia synchronizacja" przed Z44. -#}
                    <span class="kafel__wartosc kafel__wartosc--napis">{{ czas_wzgledny(podsumowanie.ostatnia_sync) }}</span>
                {% endif %}
                <span class="kafel__opis">connector R2 Płatnik</span>
            </span>
        </div>
        <div class="kafel">
            <span class="kafel__glowa">{{ ikony.oko() }}<span class="kafel__etykieta">Tryb</span></span>
            <span class="kafel__dana">
                {#- ⚠ „Tylko odczyt" to NIE jest odchylenie i nie dostaje barwy ostrzeżenia:
                    tak ten ekran ma działać (program kadrowy jest źródłem prawdy), a nie tak
                    się zepsuł. Kolorujemy wyłącznie to, co wymaga reakcji (§3.1). -#}
                <span class="kafel__wartosc kafel__wartosc--napis">tylko odczyt</span>
                <span class="kafel__opis">poprawki robi się w kadrach</span>
            </span>
        </div>
    </section>

    {#- ══════════ Jedna karta z listą firm (§3 i §4) ══════════ -#}
    <section class="card">
        {#- ⚠ **Karta MA tytuł i to nie łamie reguły z 11.10** (zlecenie Z76). Reguła i kryterium
            bramki pilnują, żeby NAZWA EKRANU nie powtarzała się w nagłówkach — mierzą to wprost
            (`powtorzenia` w `POMIAR_TYTULU`: `h2`/`h3`, których tekst równa się tekstowi `h1`).
            „Firmy z programu kadrowego" nie jest nazwą tego ekranu („Dane z kadr"), tylko nazwą
            SEKCJI — tak samo jak „Dane konta" i „Bezpieczeństwo" na „Moim koncie". Poprzedni
            komentarz w tym miejscu ujmował regułę za szeroko („tytuł karty byłby drugim tytułem
            ekranu") i to przez niego karta została bez tytułu, a dwa zdania opisu musiały go
            udawać. -#}
        <div class="card__head card__head--znak card__head--lista">
            <span class="card__znak">{{ ikony.dane() }}</span>
            <div class="card__tytuly">
                <h2>Firmy z programu kadrowego</h2>
                <p class="card__opis">Podgląd tego, co przysłał connector. Tylko do odczytu — poprawki robi się w kadrach, trafiają tu przy następnym cyklu.</p>
            </div>
            <div class="card__akcje">
                <a class="btn btn--ghost btn--akcja" href="{{ url('/dane/synchronizacja') }}">{{ ikony.odswiezenie() }}Stan synchronizacji ›</a>
            </div>
        </div>
        {% if firmy is empty %}
            <div class="card__body"><p class="empty-state">Nie ma jeszcze żadnej firmy. Firmy pojawią się tu po tym, jak connector je zgłosi, a administrator zatwierdzi.</p></div>
        {% else %}
            {#- ⚠ **Lista w RAMCE, wewnątrz `card__body`** (zlecenie Z76). Dwie rzeczy naraz:
                ramka oddziela tabelę od karty (wcześniej wiersze zaczynały się od krawędzi
                i zlewały z nagłówkiem), a `card__body` **ustanawia kontener zapytania**
                (`container-name: karta`) — bez niego wariant wąski nie miałby o co pytać,
                bo `@container` nie pyta o samego siebie. -#}
            <div class="card__body">
                <div class="dane-tabela">
                    {#- ⚠ **Jeden wiersz nagłówków kolumn zamiast etykiety w każdym wierszu**:
                        „Zatrudnienia" i „Ostatnia synchronizacja" stały dotąd przy KAŻDEJ firmie,
                        czyli przy dwóch firmach dwa razy, a przy pięćdziesięciu — pięćdziesiąt.
                        Etykieta powtórzona w każdym wierszu nie jest etykietą, tylko szumem.
                        ⚠ `aria-hidden`, bo to nagłówki WZROKOWE: czytnik dostaje nazwy z treści
                        wiersza (nazwa firmy, liczba, czas), a nie z tej belki — która dla niego
                        byłaby pięcioma napisami bez związku z żadnym wierszem. -#}
                    <div class="dane-tabela__glowa" aria-hidden="true">
                        <span>Firma</span>
                        <span>Status</span>
                        <span class="dane-tabela__do-prawej">Zatrudnienia</span>
                        <span>Ostatnia synchronizacja</span>
                        <span></span>
                    </div>
                    <ul class="dane-firmy">
                        {% for f in firmy %}
                            {#- ⚠ **Cały wiersz jest JEDNYM odnośnikiem, a „Pracownicy ›" jego częścią** —
                                `<span class="btn">` wewnątrz `<a>`, nie zagnieżdżony przycisk: przycisk
                                w odnośniku jest w HTML niedozwolony, a przeglądarka rozstrzyga to po
                                swojemu. Ta sama konstrukcja, co w wierszu konfiguracji na `/ustawienia`.
                                Oba cele prowadzą pod ten sam adres, więc drugi cel kliknięcia
                                niczego by nie dodał. -#}
                            <li>
                                <a class="dane-firma" href="{{ url('/dane/firma/' ~ f.id) }}">
                                    <span class="dane-firma__firma">
                                        <span class="dane-firma__znak">{{ ikony.firma() }}</span>
                                        <span class="dane-firma__opis">
                                            {#- ⚠ **Nazwa WYŚWIETLANA, pełna nazwa prawna w podpowiedzi**
                                                (Z76 pkt 4). Ekran służy do porównania z kadrami, więc
                                                nazwa z R2 nie może zniknąć — ale 46 znaków wersalikami
                                                w kolumnie na 1 fr nie dało się przeczytać. Kluczem
                                                porównania jest NIP i stoi niżej, jawnie. -#}
                                            <span class="dane-firma__nazwa" title="{{ f.nazwa_r2 }}">{{ f.nazwa }}</span>
                                            {#- NIP przestaje być plakietką: to dana, nie stan (Z76 pkt 3). -#}
                                            <span class="dane-firma__nip">NIP {{ nip_grupami(f.nip) }}</span>
                                        </span>
                                    </span>
                                    <span class="dane-firma__stan">
                                        {#- ⚠ Modyfikator z BIAŁEJ LISTY w jawnym warunku, nie sklejany
                                            z danych (`chip--{{ f.signup }}`): pierwszy nowy stan
                                            zgłoszenia wytworzyłby klasę, której system nie ma, i nikt
                                            by tego nie zauważył. Kropka bierze barwę z napisu. -#}
                                        {% if f.signup == 'pending' %}
                                            <span class="chip chip--warn"><span class="chip__kropka"></span>zgłoszona, czeka</span>
                                        {% elseif f.signup == 'rejected' %}
                                            <span class="chip chip--danger"><span class="chip__kropka"></span>odrzucona</span>
                                        {% else %}
                                            <span class="chip chip--accent"><span class="chip__kropka"></span>zatwierdzona</span>
                                        {% endif %}
                                        {% if f.key_name is not null %}
                                            {#- ⚠ Nazwa klucza w OSOBNYM spanie, bo wielokropek działa na
                                                pojemniku tekstu, a `.chip` jest `inline-flex` z ikoną —
                                                `text-overflow` na plakietce nie przyciąłby napisu, tylko
                                                rozpychał ją dalej (zmierzone w Z77: 273 px przy kolumnie
                                                170 px i wiersz rosnący z 71 do 80 px). Pełna nazwa
                                                w `title`, więc nic nie ginie. -#}
                                            <span class="chip dane-firma__klucz" title="{{ f.key_name }}">{{ ikony.klucz() }}<span class="dane-firma__klucz-nazwa">{{ f.key_name }}</span></span>
                                        {% else %}
                                            {#- Brak klucza to stan wymagający reakcji: connector nie ma
                                                czym się przedstawić, więc ta firma przestanie się
                                                synchronizować. -#}
                                            <span class="chip chip--warn"><span class="chip__kropka"></span>brak aktywnego klucza</span>
                                        {% endif %}
                                    </span>
                                    {#- ⚠ „Zatrudnienia", nie „Pracownicy" — ta sama nazwa, co w kaflu
                                        nad listą, bo to ta sama liczba: suma kolumny daje kafel. -#}
                                    <span class="dane-firma__liczba">{{ f.employees }}</span>
                                    {# ⚠ Znacznik przez filtr — surowy `RRRR-MM-DD HH:MM:SS` w treści dla
                                       użytkownika to ten sam błąd co „UTC”, tylko bez etykiety. #}
                                    <span class="dane-firma__czas" title="{{ f.last_sync ? czas_ze_strefa(f.last_sync) : '' }}">{{ f.last_sync ? czas_wzgledny(f.last_sync) : 'jeszcze nie było' }}</span>
                                    {#- ⚠ W wariancie wąskim ta linijka zastępuje dwie kolumny: liczbę
                                        i czas widać wtedy w jednym zdaniu, bo kafelek nie ma kolumn.
                                        Renderujemy ją ZAWSZE, a arkusz rozstrzyga, która postać jest
                                        widoczna — inaczej trzeba by liczyć szerokość skryptem. -#}
                                    <span class="dane-firma__skrot">{{ f.employees }} {{ odmiana_zatrudnien(f.employees) }} · {{ f.last_sync ? czas_wzgledny(f.last_sync) : 'jeszcze nie było synchronizacji' }}</span>
                                    <span class="btn btn--ghost btn--sm dane-firma__akcja">Pracownicy ›</span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        {% endif %}
    </section>
{% endblock %}
