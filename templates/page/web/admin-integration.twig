{% extends 'layout/web.twig' %}

{% block nazwa_ekranu %}Integracja{% endblock %}

{#- ⚠ **Bez ścieżki w belce** (zlecenie Z57 U6). Ten ekran jest POZYCJĄ MENU, a nie podstroną,
    więc w belce ma stać jeden tytuł — tak samo jak `/admin/konta`, `/admin/grupy` czy
    `/admin/widocznosc`. Stało tu „Administracja /", czyli nazwa GRUPY MENU podana jako nadrzędny
    ekran: taka ścieżka obiecuje, że po kliknięciu pierwszego członu gdzieś się trafi, a nie ma
    gdzie. Ścieżkę mają podstrony tego ekranu (`/admin/podlaczenie`, ekrany potwierdzeń) i tam
    zostaje bez zmian. -#}

{% block content %}
{% import 'partials/ikony.twig' as ikony %}
{#- ⚠ **Bez `.page__head`** (zlecenie Z35 §1): zdanie o kluczach i zgłoszeniach rozeszło się
    do nagłówków kart, których dotyczy, a przycisk kreatora zszedł do karty kluczy — bo to tam
    stoi wiersz klucza, którego dotyczy. Ekran zaczyna się od stanu, nie od opisu ekranu. -#}

    {% include 'partials/komunikat.twig' with {'tekst': notice, 'rodzaj': 'sukces'} only %}
    {% include 'partials/komunikat.twig' with {'tekst': error, 'rodzaj': 'blad'} only %}

    {% if new_key is not null %}
        <section class="card">
            <div class="card__head"><h2 class="card__title">Klucz instalacji — pokazujemy go tylko teraz</h2></div>
            <div class="card__body">
                {# ⚠ Klucz widać RAZ (§5.7), więc ekran musi dać go przenieść bez przepisywania z palca.
                   Pole tylko do odczytu; kopiowanie obsługuje plik JS, bez ani jednej linii skryptu tutaj (§6). #}
                <p class="notice notice--warn">Zobaczysz go tylko teraz. Skopiuj klucz i wklej go w konfiguracji connectora — w bazie zostaje wyłącznie jego skrót.</p>
                <div class="secret">
                    <div class="secret__row">
                        <input class="secret__value mono" id="nowy-klucz" type="text" value="{{ new_key.key }}" readonly
                               aria-label="Klucz instalacji" autocomplete="off" spellcheck="false">
                        <button type="button" class="btn btn--ghost" data-copy="nowy-klucz" data-copy-done="nowy-klucz-ok">Kopiuj</button>
                        <span class="secret__done" id="nowy-klucz-ok" role="status" hidden>Skopiowano</span>
                    </div>
                    <p class="field__hint">Wklej go w konfiguracji connectora w polu „Klucz instalacji”, a potem kliknij tam „Testuj połączenie”.</p>
                </div>
            </div>
        </section>
    {% elseif shown_key is not null %}
        <p class="notice notice--warn">{% if shown_key.expired %}Klucz „{{ shown_key.name }}” nie został wyświetlony w ciągu 5 minut i przepadł.{% else %}Klucz „{{ shown_key.name }}” był już wyświetlony — nie pokażemy go ponownie.{% endif %} Jeśli go nie zapisano, wygeneruj nowy: obecny zostanie od razu unieważniony.</p>
    {% endif %}

    {#- ⚠ Pasek kafli zamiast `.card.stats` (Z35 §2) — ten sam komponent, co na pulpicie,
        `/ustawienia`, `/admin/konta`, `/admin/grupy` i `/admin/hierarchia`.

        ⚠ **Pierwszy kafel niesie STAN, nie liczbę** — i dlatego jako jedyny ma kropkę. Cisza
        connectora wygrywa nad „połączony": klucz bywa aktywny, a danych nie ma od trzech dni,
        i to jest awaria, o której ekran ma mówić pierwszy (zlecenie 21.09 §2.2). -#}
    <section class="kafle kafle--auto" aria-label="Stan integracji">
        <div class="kafel">
            <span class="kafel__glowa">{{ ikony.integracja() }}<span class="kafel__etykieta">Connector</span></span>
            <span class="kafel__dana">
                {% if cisza is not null %}
                    <span class="kafel__wartosc kafel__wartosc--stan kafel__wartosc--uwaga"><span class="kafel__kropka kafel__kropka--uwaga"></span>milczy</span>
                    <span class="kafel__opis">nie odezwał się od {{ cisza.godzin }} h (próg {{ cisza.prog }} h) — sprawdź maszynę z connectorem i adres serwera kadrowego</span>
                {% elseif kreator.gotowe %}
                    <span class="kafel__wartosc kafel__wartosc--stan"><span class="kafel__kropka kafel__kropka--ok"></span>połączony</span>
                    <span class="kafel__opis">ostatnio {{ czas_wzgledny(podsumowanie.ostatnia_synchronizacja) }}</span>
                {% elseif connector is not null %}
                    <span class="kafel__wartosc kafel__wartosc--stan kafel__wartosc--uwaga"><span class="kafel__kropka kafel__kropka--uwaga"></span>podłączanie w toku</span>
                    <span class="kafel__opis">kreator podłączenia czeka na kolejny krok</span>
                {% else %}
                    <span class="kafel__wartosc kafel__wartosc--stan kafel__wartosc--blad"><span class="kafel__kropka kafel__kropka--blad"></span>nie podłączono</span>
                    <span class="kafel__opis">connector nie zgłosił się ani razu</span>
                {% endif %}
            </span>
        </div>
        <div class="kafel">
            <span class="kafel__glowa">{{ ikony.zespol() }}<span class="kafel__etykieta">Pracownicy</span></span>
            <span class="kafel__dana">
                <span class="kafel__wartosc">{{ podsumowanie.pracownicy }}</span>
                <span class="kafel__opis">z programu kadrowego</span>
            </span>
        </div>
        <div class="kafel">
            <span class="kafel__glowa">{{ ikony.kartka_kalendarza() }}<span class="kafel__etykieta">Nieobecności</span></span>
            <span class="kafel__dana">
                <span class="kafel__wartosc">{{ podsumowanie.nieobecnosci }}</span>
                <span class="kafel__opis">zsynchronizowane</span>
            </span>
        </div>
        <div class="kafel">
            <span class="kafel__glowa">{{ ikony.odswiezenie() }}<span class="kafel__etykieta">Przebiegi dziś</span></span>
            <span class="kafel__dana">
                <span class="kafel__wartosc">{{ podsumowanie.przebiegi_dzis }}</span>
                <span class="kafel__opis">od północy</span>
            </span>
        </div>
        <div class="kafel">
            <span class="kafel__glowa">{{ ikony.krzyzyk() }}<span class="kafel__etykieta">Zakończone błędem</span></span>
            <span class="kafel__dana">
                {#- Odchylenie to KOLOR WARTOŚCI, nie plakietka — tak samo jak w pozostałych paskach. -#}
                <span class="kafel__wartosc{{ podsumowanie.bledy_dzis > 0 ? ' kafel__wartosc--odchylenie' : '' }}">{{ podsumowanie.bledy_dzis }}</span>
                <span class="kafel__opis">od północy</span>
            </span>
        </div>
        <div class="kafel">
            <span class="kafel__glowa">{{ ikony.serwer() }}<span class="kafel__etykieta">Wersje</span></span>
            <span class="kafel__dana">
                {#- ⚠ Wersja to NAPIS, nie liczba: przy 24 px „Connector 1.4.2" łamało się w pół
                    i czytało jak dwie dane. Stąd własny rozmiar (Z35 §2). -#}
                <span class="kafel__wartosc kafel__wartosc--napis">{% if connector is not null %}Connector {{ connector.wersja ?? '—' }}{% else %}—{% endif %}</span>
                <span class="kafel__opis">R2 Płatnik {{ connector is not null ? (connector.wersja_r2 ?? '—') : '—' }}</span>
            </span>
        </div>
    </section>

    {% for r in rozjazd %}
        <section class="card">
            <div class="card__head">
                <h2 class="card__title">Dwie instalacje connectora na jednym kluczu</h2>
                <span class="card__meta">klucz „{{ r.klucz }}” — synchronizacja działa, ale osoby nie będą scalane</span>
            </div>
            <div class="card__body">
                {# ⚠ To NIE jest błąd i niczego nie zatrzymujemy (ustalenie 20.09.2026): dwie instalacje
                   bywają konfiguracją świadomą. Ekran ma powiedzieć, co z tego wynika dla danych. #}
                <p class="notice notice--warn">Firmy obsługiwane tym kluczem zgłaszają <strong>różne odciski tożsamości</strong>,
                    czyli liczą identyfikatory osób z dwóch różnych sekretów. Ta sama osoba zatrudniona w dwóch takich firmach
                    będzie u nas widziana jako <strong>dwie osoby</strong> — limity i nieobecności nie połączą się.</p>
                <div class="defs">
                    {% for o in r.odciski %}
                        <div><div class="defs__term">Odcisk <span class="mono">{{ o.odcisk }}</span></div><div class="defs__value">{{ o.firmy }}</div></div>
                    {% endfor %}
                    <div><div class="defs__term">Osób zatrudnionych w więcej niż jednej firmie</div><div class="defs__value">{{ osob_w_wielu_firmach }}</div></div>
                </div>
                <p class="field__hint">Jeśli to pomyłka: obie firmy powinien obsługiwać jeden connector (jedna instalacja, jeden sekret).
                    Jeśli tak ma być — zostaw; synchronizacja obu firm działa, a liczba wyżej pokazuje, ile osób traci połączenie między firmami.</p>
            </div>
        </section>
    {% endfor %}

    {% for s in streams|filter(s => s.identity_pending is not null) %}
        <section class="card">
            <div class="card__head"><h2 class="card__title">Strumień firmy {{ s.name }} zatrzymany</h2></div>
            <div class="card__body">
                <p class="notice notice--warn">Connector zgłasza inną tożsamość osób niż dotychczas (odcisk <span class="mono">{{ s.identity_pending }}</span> zamiast <span class="mono">{{ s.identity ?? '—' }}</span>). Żaden rekord tej firmy nie został przyjęty.</p>
                <p>Jeśli to były przenosiny bez przeniesienia sekretu — przywróć sekret na connectorze i uruchom cykl ponownie. Jeśli sekret przepadł bezpowrotnie, zaakceptuj nowy odcisk; osoby przyjdą pod nowymi identyfikatorami i trzeba będzie odtworzyć powiązania.</p>
                <div class="btn-row">
                    <a class="btn btn--danger" href="{{ url('/admin/integracja/firmy/' ~ s.id ~ '/tozsamosc') }}"
                       hx-get="{{ url('/admin/integracja/firmy/' ~ s.id ~ '/tozsamosc') }}"
                       hx-target="#potwierdzenie-tresc" hx-swap="innerHTML"
                       data-modal-open="potwierdzenie-modal">Zaakceptuj nowy odcisk</a>
                </div>
            </div>
        </section>
    {% endfor %}

    <section class="card">
        <div class="card__head card__head--znak card__head--lista">
            <span class="card__znak">{{ ikony.klucz() }}</span>
            <div class="card__tytuly">
                <h2 class="card__title">Klucze instalacji</h2>
                <p class="card__opis">Jedna firma może mieć jeden aktywny klucz. Klucz wpisujesz w connectorze.</p>
            </div>
            <div class="card__akcje">
                {#- ⚠ Jeden przycisk kreatora na cały ekran (Z35 §3): dawny „Wydaj nowy klucz" w stopce
                    karty otwierał dokładnie to samo okno, więc ekran miał dwa przyciski do jednej
                    czynności i żaden nie mówił, który jest właściwy.
                    Bez JavaScriptu to zwykły odnośnik do ekranu kreatora; ze skryptem otwiera okno. -#}
                <a class="btn btn--akcja" href="{{ url('/admin/podlaczenie') }}" data-modal-open="kreator-modal">{{ ikony.plus() }}Podłącz connector</a>
            </div>
        </div>
        <div class="table-scroll">
            {#- ⚠ Stałe szerokości: zmierzone przy 1440 px, tabela wychodziła 80 px za kartę.
                Rozpychała ją kolumna z NIP-ami — wypisywała wszystkie numery klucza, więc rosła
                z liczbą firm. Z35 §3 zdejmuje ten problem u źródła: zamiast listy numerów stoi
                plakietka „w zakresie / zatwierdzone", a nazwy i NIP-y są w `title`.
                ⚠ `table__grow` (width: 100%) zdjęte: z `table-layout: fixed` bije się z colgroup
                i wygrywa — ta sama pułapka, na której przejechaliśmy się przy dzienniku zdarzeń. -#}
            <table class="table table--stale table--zawija table--klucze">
                <colgroup>
                    <col class="col--klucz-nazwa"><col class="col--klucz-zakres"><col class="col--klucz-utworzony">
                    <col class="col--klucz-uzycie"><col class="col--klucz-stan"><col class="col--klucz-akcja">
                </colgroup>
                <thead>
                    <tr><th>Nazwa</th><th>Firmy</th><th>Utworzony</th><th>Użycie</th><th>Stan</th><th>Działania</th></tr>
                </thead>
                <tbody>
                {% for k in keys %}
                    {#- Zgłoszenia tego klucza: własne i te bez przypisanego klucza. ⚠ Zgłoszenie bez
                        klucza musi być gdzieś widoczne — niepokazane nigdzie czekałoby w bazie
                        bez śladu w interfejsie. -#}
                    {% set czeka = zgloszenia_kluczy[k.id]|length %}
                    <tr>
                        <td class="cell--zawija">
                            <span class="klucz-wiersz">
                                <span class="klucz-wiersz__znak" aria-hidden="true">{{ ikony.klucz() }}</span>
                                <span class="klucz-wiersz__dane">
                                    <span class="klucz-wiersz__nazwa">{{ k.name }}</span>
                                    {#- ⚠ Sam POCZĄTEK klucza, i tak jest napisane w `title`: całego klucza
                                        nie pokazujemy nigdy po wydaniu, bo w bazie jest tylko jego skrót. -#}
                                    <span class="klucz-wiersz__prefix mono" title="Początek klucza. Całego klucza nie pokazujemy.">{{ k.prefix }}…</span>
                                </span>
                            </span>
                        </td>
                        <td>
                            {% if k.bez_firm %}
                                <span class="chip chip--warn"><span class="chip__kropka"></span>brak firm</span>
                            {% else %}
                                {#- Nazwy i NIP-y schodzą do `title`: w kolumnie stoi liczba, bo to ona mówi,
                                    czy zakres jest kompletny, a nazwy rosły w nieskończoność. -#}
                                <span class="chip zakres-chip" title="{% for f in firmy %}{{ f.name }} ({{ nip_grupami(f.nip) }}){{ f.nip in k.nips ? ' — w zakresie' : ' — poza zakresem' }}{% if not loop.last %}; {% endif %}{% endfor %}">{{ ikony.firma() }}{{ k.nips|length }}/{{ firmy|length }}</span>
                            {% endif %}
                        </td>
                        <td class="table__mute">{{ czas_data(k.created_at) }}</td>
                        <td class="table__mute">{{ czas_wzgledny(k.last_used_at) }}</td>
                        <td>
                            {% if k.state == 'active' %}
                                {% if k.milczy is not null %}
                                    <span class="chip chip--warn"><span class="chip__kropka"></span>milczy od {{ czas_wzgledny(k.last_used_at) }}</span>
                                {% else %}
                                    <span class="chip chip--accent"><span class="chip__kropka"></span>aktywny</span>
                                {% endif %}
                            {% elseif k.state == 'issued' %}
                                {# Klucz wydany, którego connector jeszcze nie użył — stan wymagający uwagi,
                                   ale NIE powód, żeby cokolwiek zabijać: stary klucz pracuje dalej. #}
                                <span class="chip chip--warn"><span class="chip__kropka"></span>czeka na pierwsze użycie</span>
                                {% if k.czeka_godzin is not null %}<span class="cell__sub">czeka od {{ czas_wzgledny(k.created_at) }} — wklej go w connectorze</span>{% endif %}
                            {% else %}
                                <span class="chip chip--danger"><span class="chip__kropka"></span>{{ k.powod }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if k.state == 'active' or k.state == 'issued' %}
                                <div class="btn-row btn-row--jedna-linia klucz-akcje">
                                    {#- ⚠ „Zakres" to zwykły odnośnik z prawdziwym adresem (`?okno=zakres`),
                                        a okno stoi już w stronie — bez JavaScriptu ekran wraca z otwartym
                                        oknem, ze skryptem otwiera je na miejscu (wzorzec z Z29). -#}
                                    <a class="btn btn--akcja" href="{{ url('/admin/integracja') }}?okno=zakres&amp;klucz={{ k.id }}"
                                       data-modal-open="zakres-{{ k.id }}">{{ ikony.firma() }}Zakres{% if czeka > 0 %}<span class="btn__znacznik" aria-hidden="true">{{ czeka }}</span><span class="visually-hidden">— {{ czeka }} {{ czeka == 1 ? 'zgłoszenie czeka' : 'zgłoszenia czekają' }} na decyzję</span>{% endif %}</a>
                                    {#- Oba odnośniki prowadzą do kroku potwierdzenia — bez JS otwiera się
                                        pełny ekran, z JS ta sama treść ląduje w oknie nad tabelą (§5.6). -#}
                                    <a class="btn btn--akcja" href="{{ url('/admin/integracja/klucze/' ~ k.id ~ '/wymien') }}"
                                       hx-get="{{ url('/admin/integracja/klucze/' ~ k.id ~ '/wymien') }}"
                                       hx-target="#potwierdzenie-tresc" hx-swap="innerHTML"
                                       data-modal-open="potwierdzenie-modal">{{ ikony.odswiezenie() }}Wymień klucz</a>
                                    <a class="btn btn--akcja btn--akcja-groznie" href="{{ url('/admin/integracja/klucze/' ~ k.id ~ '/uniewaznij') }}"
                                       hx-get="{{ url('/admin/integracja/klucze/' ~ k.id ~ '/uniewaznij') }}"
                                       hx-target="#potwierdzenie-tresc" hx-swap="innerHTML"
                                       data-modal-open="potwierdzenie-modal">{{ ikony.krzyzyk() }}Unieważnij</a>
                                </div>
                            {% else %}
                                {#- ⚠ Kasowanie TYLKO dla klucza unieważnionego — czynnego nie ma czym
                                    skasować z tego ekranu i nie chodzi o ukryty przycisk: warunek
                                    `status <> 'active'` stoi w zapytaniu (`ApiKeyRepository::usun`).
                                    Czynny klucz trzeba najpierw unieważnić, bo to decyzja o zatrzymaniu
                                    synchronizacji u klienta i ma własny ekran potwierdzenia. -#}
                                <div class="btn-row btn-row--jedna-linia klucz-akcje">
                                    <a class="btn btn--akcja btn--akcja-groznie" href="{{ url('/admin/integracja/klucze/' ~ k.id ~ '/usun') }}"
                                       hx-get="{{ url('/admin/integracja/klucze/' ~ k.id ~ '/usun') }}"
                                       hx-target="#potwierdzenie-tresc" hx-swap="innerHTML"
                                       data-modal-open="potwierdzenie-modal">{{ ikony.kosz() }}Skasuj</a>
                                </div>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="table__empty">Nie wydano jeszcze żadnego klucza.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="card__foot card__foot--notka">
            {#- ⚠ Notka w ramce ze znakiem „i", a nie zdanie w stopce (Z35 §3): to jest odpowiedź
                na pytanie „czy wymiana klucza coś zepsuje", zadawane dokładnie w chwili patrzenia
                na przycisk „Wymień klucz". Treść zgodna z regułą z 20.09.2026 — ekran mówił kiedyś
                „stary działa 30 dni", a żadnego terminu nie ma. -#}
            <p class="notka-info">
                <span class="notka-info__znak" aria-hidden="true">{{ ikony.info() }}</span>
                <span><strong>Wymiana klucza</strong> nie przerywa synchronizacji: stary klucz działa, dopóki nowy nie zakończy pierwszego przebiegu, potem sam się unieważnia. Dane firmy zostają, nic nie ładuje się od nowa.</span>
            </p>
        </div>
    </section>

    <section class="card">
        <div class="card__head card__head--znak card__head--lista">
            <span class="card__znak">{{ ikony.lista() }}</span>
            <div class="card__tytuly">
                <h2 class="card__title">Ostatnie przebiegi</h2>
                <p class="card__opis">Każda firma synchronizuje się osobno.</p>
            </div>
            {% if can('data.view') %}
                <div class="card__akcje">
                    <a class="btn btn--akcja" href="{{ url('/dane/synchronizacja') }}">Pełny stan synchronizacji ›</a>
                </div>
            {% endif %}
        </div>
        <div class="table-scroll">
            <table class="table table--przebiegi">
                <thead>
                    <tr><th>Rozpoczęty</th><th class="table__grow">Firma</th><th class="table__num">Czas</th><th class="table__num">Rekordy</th><th class="table__num">Konflikty</th><th>Wynik</th></tr>
                </thead>
                <tbody>
                {% for r in runs %}
                    <tr>
                        {#- ⚠ Godzina nad datą, bez sekund i bez słowa „dziś" (Z35 §5): przebiegi idą
                            co kilka minut, więc to godzina rozróżnia wiersze, a data je tylko grupuje.
                            „Dziś" przy dwudziestu wierszach z tego samego dnia nie niosło niczego. -#}
                        <td class="przebieg-czas">
                            <span class="przebieg-czas__godzina">{{ czas_godzina_krotka(r.started_at) }}</span>
                            <span class="przebieg-czas__data">{{ czas_data(r.started_at) }}</span>
                        </td>
                        <td class="table__grow">{{ r.company }}</td>
                        <td class="table__num przebieg-liczba" data-etykieta="czas">{{ r.seconds is null ? '—' : r.seconds ~ ' s' }}</td>
                        <td class="table__num przebieg-liczba" data-etykieta="rekordy">{{ r.rekordy }}</td>
                        <td class="table__num przebieg-liczba" data-etykieta="konflikty">{{ r.konflikty }}</td>
                        <td>
                            {% if r.status == 'closed' %}
                                <span class="chip chip--accent"><span class="chip__kropka"></span>zakończony{% if r.pelne %} · pełne ładowanie{% endif %}</span>
                            {% elseif r.status == 'open' %}
                                <span class="chip chip--warn"><span class="chip__kropka"></span>w toku ({{ r.phase }})</span>
                            {% else %}
                                <span class="chip chip--danger"><span class="chip__kropka"></span>przerwany — {{ r.status }}</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="table__empty">Connector nie wykonał jeszcze żadnego przebiegu.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    {#- Okno zakresu dla każdego klucza, który da się jeszcze obsłużyć. Osadzone w stronie,
        żeby działało bez JavaScriptu (patrz komentarz w partialu). -#}
    {% for k in keys|filter(k => k.state == 'active' or k.state == 'issued') %}
        {% include 'partials/okno-zakres-klucza.twig' with {
            'k': k,
            'firmy': firmy,
            'zgloszenia': zgloszenia_kluczy[k.id],
            'odrzucone': odrzucone_kluczy[k.id],
            'otwarte': okno_zakres == k.id
        } only %}
    {% endfor %}

    {# Okno potwierdzeń: treść dociąga htmx z tej samej trasy, którą bez JS otwiera zwykły odnośnik. #}
    <dialog id="potwierdzenie-modal" class="modal" aria-labelledby="potwierdzenie-modal-title">
        <div class="modal__head">
            <h3 id="potwierdzenie-modal-title">Potwierdzenie</h3>
            <button type="button" class="modal__close" data-modal-close="potwierdzenie-modal" aria-label="Zamknij okno">{{ ikony.krzyzyk() }}</button>
        </div>
        <div class="modal__body" id="potwierdzenie-tresc">
            <p class="table__empty">Wczytuję…</p>
        </div>
    </dialog>

    <dialog id="kreator-modal" class="modal modal--kreator" aria-labelledby="kreator-modal-title">
        <div class="modal__head modal__head--znak">
            <span class="card__znak">{{ ikony.wtyczka() }}</span>
            <div class="card__tytuly">
                <h3 id="kreator-modal-title">Podłączenie connectora</h3>
                {#- ⚠ Zdanie o stanie („Cztery kroki… Wszystkie zrobione.") przychodzi Z FRAGMENTEM,
                    nie stąd: zmienia się po każdym kroku, a nagłówek okna jest statyczny.
                    Stoi w pierwszej linii treści, czyli dokładnie pod tytułem. -#}
            </div>
            <button type="button" class="modal__close" data-modal-close="kreator-modal" aria-label="Zamknij okno">{{ ikony.krzyzyk() }}</button>
        </div>
        {# Treść dociągana po otwarciu okna — dopóki jest zamknięte, nie leci ani jedno żądanie. #}
        <div class="modal__body"
             hx-get="{{ url('/admin/podlaczenie/stan') }}"
             hx-trigger="kreator:pokaz from:body"
             hx-target="this"
             hx-swap="innerHTML">
            <p class="table__empty">Wczytuję stan podłączenia…</p>
        </div>
        {#- ⚠ W stopce tylko „Zamknij" (Z35 §6). Odnośnik „Otwórz kreator jako osobny ekran" zniknął:
            adres `/admin/podlaczenie` zostaje dla przeglądarki bez JavaScriptu (tam prowadzi
            przycisk „Podłącz connector"), ale w oknie był trzecim wyjściem do tego samego miejsca. -#}
        <div class="modal__foot">
            <div class="btn-row btn-row--jedna-linia">
                <button type="button" class="btn btn--primary" data-modal-close="kreator-modal">Zamknij</button>
            </div>
        </div>
    </dialog>
{% endblock %}
