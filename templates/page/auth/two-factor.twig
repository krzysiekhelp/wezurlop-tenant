{% extends layout_auth %}

{% block title %}Kod weryfikacyjny — wezurlop{% endblock %}

{% block content %}
    <p class="eyebrow">Weryfikacja dwuetapowa</p>
    <h1>{{ backup ? 'Kod zapasowy' : 'Kod z aplikacji' }}</h1>
    <p>{{ backup ? 'Wpisz jeden z kodów zapasowych. Każdy działa tylko raz.' : 'Wpisz 6-cyfrowy kod z aplikacji uwierzytelniającej.' }}</p>
    {% if error is not null %}
        <p class="notice notice--danger" role="alert">{{ error }}</p>
    {% endif %}

    <form method="post" action="{{ url('/logowanie/kod') }}" class="stack">
        {% include 'partials/csrf.twig' %}
        <input type="hidden" name="mode" value="{{ backup ? 'backup' : 'totp' }}">
        <div class="field">
            {% if backup %}
                <label for="code">Kod zapasowy</label>
                <input class="input input--code" id="code" name="code" type="text" maxlength="16" autocomplete="off" autocapitalize="characters" required>
            {% else %}
                <label for="code">Kod</label>
                <input class="input input--code" id="code" name="code" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required>
            {% endif %}
        </div>
        <button type="submit" class="btn btn--primary">Potwierdź</button>
    </form>

    <p>
        {% if backup %}
            <a href="{{ url('/logowanie/kod') }}">Użyj kodu z aplikacji</a>
        {% else %}
            <a href="{{ url('/logowanie/kod') }}?tryb=zapasowy">Nie mam dostępu do telefonu — użyj kodu zapasowego</a>
        {% endif %}
    </p>
    <form method="post" action="{{ url('/wyloguj') }}">
        {% include 'partials/csrf.twig' %}
        <button type="submit" class="btn btn--quiet">Anuluj i wyloguj</button>
    </form>
{% endblock %}
