{% extends layout_auth %}

{% block title %}Nowe hasło — wezurlop{% endblock %}

{% block content %}
    <p class="eyebrow">Reset hasła</p>
    <h1>Ustaw nowe hasło</h1>
    <p>Po zapisaniu nowego hasła wszystkie pozostałe sesje konta zostaną zakończone.</p>
    {% if error is not null %}
        <p class="notice notice--danger" role="alert">{{ error }}</p>
    {% endif %}
    <form method="post" action="{{ url('/haslo/nowe') }}" class="stack">
        {% include 'partials/csrf.twig' %}
        {% include 'partials/new-password.twig' %}
        <button type="submit" class="btn btn--primary">Zapisz hasło</button>
    </form>
{% endblock %}
