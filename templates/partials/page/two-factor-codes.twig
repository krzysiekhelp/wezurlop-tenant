{#- Kody zapasowe — jednorazowe pokazanie rozstrzyga serwer (sesja), nie przeglądarka. -#}
<section class="card">
    <div class="card__body">
        <p class="notice notice--warn">Każdy kod działa jeden raz i pozwala zalogować się bez telefonu.
            <strong>Zobaczysz je tylko teraz</strong> — zapisz je lub pobierz i przechowuj w bezpiecznym miejscu.</p>
        {% if error is not null %}
            {% include 'partials/komunikat.twig' with {'tekst': error, 'rodzaj': 'blad'} only %}
        {% endif %}
        <ol class="backup-grid">
            {% for code in codes %}
                <li class="backup-code">{{ code }}</li>
            {% endfor %}
        </ol>
        <form method="post" action="{{ url('/ustawienia/2fa/kody/pobierz') }}">
            {% include 'partials/csrf.twig' %}
            <button type="submit" class="btn btn--ghost">Pobierz jako plik tekstowy</button>
        </form>
        <form method="post" action="{{ url('/ustawienia/2fa/kody/potwierdz') }}" class="stack">
            {% include 'partials/csrf.twig' %}
            <div class="field field--check">
                <input id="codes-saved" name="saved" type="checkbox" value="1" required>
                <label for="codes-saved">Zapisałem kody w bezpiecznym miejscu</label>
            </div>
            <button type="submit" class="btn btn--primary">Gotowe</button>
        </form>
    </div>
</section>
