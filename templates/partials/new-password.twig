{#- Pola nowego hasła; zmienne: token, min_length. -#}
{% import 'partials/ikony.twig' as ikona %}
<input type="hidden" name="token" value="{{ token }}">
<div class="field">
    <label for="new-password">Nowe hasło</label>
    <div class="input-group">
        <input class="input" id="new-password" name="password" type="password" minlength="{{ min_length }}" autocomplete="new-password" required>
        <button class="input-group__action" type="button" data-toggle-password="new-password"
                aria-controls="new-password" aria-pressed="false" aria-label="Pokaż hasło" hidden>{{ ikona.oko() }}{{ ikona.oko_przekreslone() }}</button>
    </div>
    <p class="field__hint">Co najmniej {{ min_length }} znaków. Długie hasło z kilku słów jest łatwiejsze do zapamiętania i trudniejsze do odgadnięcia.</p>
</div>
<div class="field">
    <label for="new-password-repeat">Powtórz hasło</label>
    <input class="input" id="new-password-repeat" name="password_repeat" type="password" minlength="{{ min_length }}" autocomplete="new-password" required>
</div>
