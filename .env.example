# Wzór pliku .env — bez sekretów. Prawdziwy .env leży poza repozytorium (.gitignore),
# prawa 640, właściciel konta, grupa użytkownika serwera WWW. Wypełnia go instalator (M8).

APP_ENV=prod
# Adres, pod którym aplikacja jest widoczna: http(s)://host, bez ścieżki.
# Linki w wiadomościach budowane są wyłącznie z niego, nigdy z nagłówka Host.
APP_URL=https://urlopy.example.pl
# Prefiksy adresów (docs/szkielet-tenanta.md rozdz. 3) — ustala je instalator testem, nie zgadywaniem.
# Zmienne serwera o tych nazwach (SetEnv) mają pierwszeństwo przed .env.
#   APP_BASE_PATH        — gdzie są zasoby: pusty, a bez mod_rewrite przy katalogu domeny = korzeń: /public
#   APP_FRONT_CONTROLLER — co dołożyć, żeby trafić do routera: pusty, a bez mod_rewrite: /index.php
APP_BASE_PATH=
APP_FRONT_CONTROLLER=
# ⚠ Wersja zasobów jest WYLICZANA: na dev z `filemtime`, w paczce ze skrótu treści
# (public/assets/wersje.json). Ta wartość jest tylko ścieżką zapasową dla zasobu, którego
# nie ma w manifeście — ręczne podbijanie jej nic nie daje i nie jest potrzebne.
ASSET_VERSION=1

# WEZURLOP_APP_PATH — położenie aplikacji w wariancie „aplikacja powyżej katalogu domeny”.
# NIE ustawia się jej tutaj (front controller musi ją znać, zanim znajdzie .env), tylko w .htaccess
# katalogu domeny:  <IfModule mod_env.c> SetEnv WEZURLOP_APP_PATH /pelna/sciezka/do/aplikacji </IfModule>
# Położenie .env w tym wariancie: zmienna serwera WEZURLOP_ENV_PATH (domyślnie <aplikacja>/.env).

# Ścieżki konfigurowalne (wariant „aplikacja powyżej katalogu domeny”); puste = katalogi w korzeniu aplikacji.
STORAGE_PATH=
VAR_PATH=

# Konto aplikacyjne: tylko SELECT, INSERT, UPDATE, DELETE (CLAUDE.md §4).
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=
# Konto migracyjne (DDL) — używane wyłącznie przez phinx.
DB_MIG_USER=
DB_MIG_PASS=
DB_PORT=3306
# Tryb jednego konta (hosting bez możliwości drugiego użytkownika bazy, np. home.pl): DB_* i DB_MIG_*
# mają te same wartości, a DB_SINGLE_ACCOUNT=1 — stan obniżony, widoczny na /diagnostyka; bezpiecznik DDL
# w profilu aplikacji i kopia zapasowa przed aktualizacją obowiązkowa (CLAUDE.md §4).
DB_SINGLE_ACCOUNT=0
# TLS do bazy (CLAUDE.md §4): auto = szyfrowanie, gdy host nie jest lokalny; required | disabled.
# DB_SSL_CA = plik CA serwera bazy → weryfikacja certyfikatu. Bez CA: szyfrowanie bez weryfikacji
# (chroni przed podsłuchem, nie przed aktywnym atakiem w sieci).
DB_SSL=auto
DB_SSL_CA=

# Klucz aplikacji: 32 losowe bajty, „base64:...”. Generuje go instalator; utrata = ponowne parowanie 2FA
# u wszystkich użytkowników. Szyfruje sekrety TOTP i służy do HMAC adresów IP.
APP_KEY=

# ⚠ Poczty NIE KONFIGURUJE SIĘ TUTAJ (etap 7.2). Serwer SMTP, port, szyfrowanie, użytkownik,
# hasło (szyfrowane kluczem APP_KEY), adres i nazwa nadawcy siedzą w BAZIE i zmienia się je
# na ekranie „Ustawienia → Poczta", z wysyłką próbną. Powód: serwer poczty klienta zmienia się
# po instalacji, a `.env` pisze instalator raz — edycja pliku przez FTP to ryzyko literówki
# w miejscu, które przy błędzie wywraca całą aplikację, a nie jedną funkcję.
# ⚠ `MAIL_*` nie jest już czytane. Zrzut wiadomości do `var/mail/*.eml` włącza się sam,
# gdy APP_ENV=dev i poczta nie jest skonfigurowana; w produkcji brak konfiguracji to BŁĄD,
# a nie cichy zapis do pliku.

# HSTS (CLAUDE.md §13): wysyłany tylko po HTTPS; 0 = nie wysyłaj; preload nigdy.
# Środowisko deweloperskie: HSTS_MAX_AGE=300, HSTS_INCLUDE_SUBDOMAINS=false.
# Nagłówek X-Robots-Tag: noindex, nofollow (aplikacja kadrowa nie jest witryną). 0 wyłącza świadomie.
NOINDEX=true
# ⚠ Obowiązkowe 2FA administratora tenanta. 0 = stan obniżony, widoczny na /diagnostyka (tylko dev).
ADMIN_2FA_REQUIRED=true
# Instalator u klienta zapisuje 2592000 (30 dni) i false — objęcie subdomen włącza administrator świadomie.
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

# Licencja (docs/szkielet-tenanta.md rozdz. 11). Klucz PUBLICZNY panelu w pliku — nie w kodzie strefy kodowanej.
# Puste = config/license-public.key i var/license.json. Klucza prywatnego nigdy tu nie ma.
LICENSE_PUBLIC_KEY_PATH=
LICENSE_FILE=
# Panel wezurlop: adres API i klucz instalacji (nadaje go rejestracja w panelu).
PANEL_URL=
PANEL_INSTALLATION_KEY=

# Token instalacyjny z panelu — wyłącznie we wstępnym .env przed instalacją (prawa 660, właściciel =
# użytkownik serwera WWW, żeby instalator mógł zapisać plik i zacisnąć prawa do 0640).
# Instalator usuwa go przy zapisie konfiguracji. Minimum 16 znaków.
# INSTALL_TOKEN=

# Wdrożenie (docs/profile-hostingu.md) — zapisuje instalator. Profil: apache | ideawebserver | minimal;
# wpływa wyłącznie na .htaccess, cron i przekazanie ścieżki, nigdy na uprawnienia.
SERVER_PROFILE=
SERVER_SOFTWARE=
# Adres, pod którym serwer łączy się sam ze sobą przy sondach HTTP (kanarek storage/).
SELF_ADDR=
# Potwierdzona częstotliwość crona w minutach (0 = nieznana). Przy cronie co 15 min i rzadszym
# QUEUE_ON_REQUEST=1: pilne wiadomości (reset hasła, zaproszenie) wysyłane także po zwykłych żądaniach.
CRON_INTERVAL_MINUTES=5
QUEUE_ON_REQUEST=0

# Zaufane proxy (np. Cloudflare): adresy IP lub CIDR, po przecinku. Domyślnie puste.
TRUSTED_PROXIES=
